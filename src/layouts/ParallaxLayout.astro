---
import Layout from './Layout.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<!--
	Layout for pages with the fixed parallax hero. Same <head> as the base
	layout (reused, not duplicated); the only structural difference is on the
	component side: ParallaxHero renders the scene position:fixed with a
	negative z-index, so normal-flow page content paints above it and scrolls
	up over the frozen end frame.
-->
<Layout title={title} description={description}>
	<slot />
</Layout>

<script>
	/* Content dissolve under the sticky glass headers (header-fade
	   experiment). The CSS mask below is a fixed gradient in VIEWPORT
	   space, but mask coordinates are element-relative, so this handler
	   feeds each fading element its own viewport top via --fade-vt on
	   every scroll frame. Masked targets are the siblings that follow a
	   sticky header, i.e. exactly the content that scrolls behind it;
	   headers passed through SectionBand's slot stay unmasked. Honors
	   reduced motion by leaving the status quo (content slides behind
	   the glass) untouched. */
	const fadeTargets = document.querySelectorAll<HTMLElement>(
		'.c-section-band .c-section-band__header ~ *',
	);
	if (
		fadeTargets.length > 0 &&
		!window.matchMedia('(prefers-reduced-motion: reduce)').matches
	) {
		let fadeQueued = false;
		const updateFades = () => {
			fadeQueued = false;
			/* read all rects first, then write, to avoid layout thrash */
			const rects = Array.from(fadeTargets, (el) => el.getBoundingClientRect());
			rects.forEach((rect, i) => {
				const el = fadeTargets[i];
				/* Skip elements below the dissolve band (viewport y 136,
				   matching the CSS gradient stop): their mask is fully
				   opaque either way, and writing --fade-vt forces the
				   masked element to re-rasterize, so churning it for the
				   whole below-fold page on every scroll frame wastes paint
				   work on mobile. The CSS fallback (opaque) covers them.
				   Elements in or above the band are few, so always write
				   them; that also covers anchor jumps that land an element
				   above the band without it ever crossing it. */
				if (rect.top >= 136) {
					el.style.removeProperty('--fade-vt');
				} else {
					el.style.setProperty('--fade-vt', `${rect.top}px`);
				}
			});
		};
		const queueFades = () => {
			if (!fadeQueued) {
				fadeQueued = true;
				requestAnimationFrame(updateFades);
			}
		};
		updateFades();
		window.addEventListener('scroll', queueFades, { passive: true });
		window.addEventListener('resize', queueFades);
		window.addEventListener('load', queueFades);
	}
</script>

<style is:global>
	/* EXPERIMENT (Philip, 2026-08-02): transparent page content on parallax
	   pages. The fixed scene freezes at its end state behind everything;
	   instead of the section bands covering it with opaque gray/white/dark,
	   let the frozen frame + dark vignette zone be the backdrop for the
	   whole page. Scoped to pages mounting .c-parallax so the blog and any
	   non-parallax pages keep their normal surfaces. Text colors are NOT
	   flipped here; light-mode dark text over the dark vignette zone is the
	   known legibility risk under review. */
	body:has(.c-parallax) .c-section-band {
		background: transparent;
	}

	/* TEMPORARY (Philip, 2026-08-02): lock parallax pages to the dark theme
	   while the transparent-content experiment is evaluated in dark mode.
	   Mirrors the @media (prefers-color-scheme: dark) block in the theme
	   layer of global.css; delete this block to restore light-mode
	   following. */
	body:has(.c-parallax) {
		--color-surface: #212529;
		--color-surface-alt: #2b3035;
		--color-surface-subtle: rgb(255 255 255 / 4%);
		--color-surface-border: rgb(255 255 255 / 15%);
		--color-on-surface: #f8f9fa;
		--color-on-surface-muted: #adb5bd;
		--color-border: rgb(255 255 255 / 15%);
		--color-input-border: #495057;
		--color-input-text: #f8f9fa;
		--color-input-addon-bg: rgb(255 255 255 / 8%);
		--color-rule: rgb(255 255 255 / 20%);
		--color-dropcap: #d98080;
		--color-link: #6ea8fe;
		--color-link-hover: #9ec5fe;
		color-scheme: dark;
	}

	/* EXPERIMENT (Philip, 2026-08-02): sticky glass section headers, using
	   the fal-ai playground's content-panel treatment (translucent dark +
	   backdrop blur). Each section's header pins to the viewport top while
	   its section scrolls; content flows behind the frosted glass and the
	   next section's header pushes it off (natural sticky stacking). The
	   small top offset keeps the rounded bar from kissing the viewport
	   edge. Scoped to parallax pages like the rest of the experiment. */
	body:has(.c-parallax) .c-section-band__header {
		position: sticky;
		top: var(--space-2);
		z-index: 5;
		/* glass hugs the title text instead of spanning the container */
		width: fit-content;
		margin-inline: auto;
		padding: var(--space-3) var(--space-4);
		background: rgba(10, 16, 6, .55);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		border-radius: 14px;
	}

	/* content dissolve (header-fade experiment): the content that scrolls
	   behind a pinned glass header fades out over a fixed viewport band
	   ending at the glass's bottom edge (~70px), so it dissolves under
	   the frosted pill instead of visibly sliding behind it and off the
	   top of the page. The gradient is positioned in viewport space via
	   --fade-vt (the element's own viewport top), set per scroll frame by
	   the script in this layout; the huge fallback keeps content opaque
	   if the script never runs. Targets the header's following siblings
	   so slot-passed headers (#about, #education-projects) stay solid. */
	body:has(.c-parallax) .c-section-band__header ~ * {
		-webkit-mask-image: linear-gradient(to bottom,
			transparent calc(64px - var(--fade-vt, 100000px)),
			#000 calc(136px - var(--fade-vt, 100000px)));
		mask-image: linear-gradient(to bottom,
			transparent calc(64px - var(--fade-vt, 100000px)),
			#000 calc(136px - var(--fade-vt, 100000px)));
	}

	/* no underlines under the glass titles (Philip, 2026-08-02) */
	body:has(.c-parallax) .c-section-band__rule {
		display: none;
	}

	/* glass padding stays visually even: the title's default bottom margin
	   (meant to space the now-hidden rule) would add height below the text
	   inside the pill */
	body:has(.c-parallax) .c-section-band__header .c-section-band__title {
		margin-bottom: 0;
	}

	/* global.css zeroes #hire-me's header margin (from when the band was
	   title-only); with the contact content merged into the band, restore
	   the standard band header spacing */
	body:has(.c-parallax) #hire-me .c-section-band__header {
		margin-bottom: var(--space-5);
	}
</style>
