---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/* parallax pages: extend the layout viewport under the iOS status bar
	   and bottom toolbar (edge to edge). Opt-in per page: regular pages
	   assume the viewport starts below the system chrome. */
	viewportFitCover?: boolean;
}

const {
	title = 'Philip Brocoum - Lead Software Engineer',
	description = 'Personal website for Philip Brocoum, Lead Software Engineer in Portland, OR.',
	viewportFitCover = false,
} = Astro.props;

// Link previews (Open Graph and X/Twitter cards) need absolute URLs.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/og-image.jpg', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="classic">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content={viewportFitCover ? 'width=device-width, initial-scale=1, viewport-fit=cover' : 'width=device-width, initial-scale=1'} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Philip Brocoum" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Philip Brocoum, Lead Software Engineer, Portland, Oregon, beside a 3D island at night with a campfire and a desk." />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Work+Sans:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
