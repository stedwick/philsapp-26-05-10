---
import ContactForm from '../components/ContactForm.astro';
import ContactInfo from '../components/ContactInfo.astro';
import MediaGrid from '../components/MediaGrid.astro';
import MediaItem from '../components/MediaItem.astro';
import ParallaxHero from '../components/ParallaxHero.astro';
import SectionBand from '../components/SectionBand.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SplitIntro from '../components/SplitIntro.astro';
import WorkCard from '../components/WorkCard.astro';
import ParallaxLayout from '../layouts/ParallaxLayout.astro';
import { getCollection } from 'astro:content';
import { icons } from '../data/site';
import { createResumeViewModel } from '../data/resume-data.mjs';

const [
	profileEntries,
	sectionEntries,
	skillEntries,
	experienceEntries,
	educationEntries,
	projectEntries,
	personalLinkEntries,
	contactEntries,
	assetEntries,
] = await Promise.all([
	getCollection('profile'),
	getCollection('sections'),
	getCollection('skills'),
	getCollection('experience'),
	getCollection('education'),
	getCollection('projects'),
	getCollection('personalLinks'),
	getCollection('contact'),
	getCollection('assets'),
]);

const resume = createResumeViewModel(
	{
		profile: profileEntries.map((entry) => entry.data),
		sections: sectionEntries.map((entry) => entry.data),
		skills: skillEntries.map((entry) => entry.data),
		experience: experienceEntries.map((entry) => entry.data),
		education: educationEntries.map((entry) => entry.data),
		projects: projectEntries.map((entry) => entry.data),
		personalLinks: personalLinkEntries.map((entry) => entry.data),
		contact: contactEntries.map((entry) => entry.data),
		assets: assetEntries.map((entry) => entry.data),
	},
	icons,
);
---

<ParallaxLayout>
	<ParallaxHero profile={resume.profile} socialLinks={resume.socialLinks} chevronIcon={icons.ChevronDown} />

	<SectionBand id="about" title={resume.sections.about.title} mobileTitleLines={resume.sections.about.titleShort} tone="light">
		<SplitIntro paragraphs={resume.sections.about.body} />
	</SectionBand>

	<SectionBand id="about-skills" title="Phil's Skillset" tone="white">
		<h5 class="c-skill-group__title">Technical Chops</h5>
		<MediaGrid class="c-skill-grid">
			{/* Skill descriptions and links hidden for now; data stays in skills.json. Restore by passing body/href through again. */}
			{resume.skills.technical.map(({ body: _description, href: _url, ...skill }) => <MediaItem {...skill} />)}
		</MediaGrid>
		<h5 class="c-skill-group__title">Leadership Qualities</h5>
		<MediaGrid class="c-skill-grid">
			{resume.skills.leadership.map(({ body: _description, href: _url, ...skill }) => <MediaItem {...skill} />)}
		</MediaGrid>
	</SectionBand>

	<SectionBand id="career" title={resume.sections.career.title} tone="light">
		<SplitIntro paragraphs={resume.sections.career.body} />
	</SectionBand>

	<SectionBand id="career-sites" tone="white">
		<div class="l-card-grid">
			{resume.career.map((entry) => <WorkCard {...entry} />)}
		</div>
	</SectionBand>

	<SectionBand id="education-projects" tone="dark">
		<div class="c-resume-panels">
			<section aria-labelledby="education-heading">
				<header class="c-section-band__header">
					<h2 id="education-heading" class="c-section-band__title">{resume.sections.education.title}</h2>
					<p>{resume.sections.education.body[0]}</p>
				</header>
				<div class="l-stacked-media-list">
					{resume.education.map((item) => <MediaItem {...item} compact />)}
				</div>
			</section>

			<div class="c-education-separator" aria-hidden="true">
				<span>&sect;</span>
			</div>

			<section aria-labelledby="projects-heading">
				<header class="c-section-band__header">
					<h2 id="projects-heading" class="c-section-band__title">{resume.sections.projects.title}</h2>
					<p>{resume.sections.projects.body[0]}</p>
				</header>
				<div class="l-stacked-media-list">
					{resume.projects.map((item) => <MediaItem {...item} compact />)}
				</div>
			</section>
		</div>
	</SectionBand>

	<SectionBand id="interests" title={resume.sections.personalLife.title} tone="light">
		<p>{resume.sections.personalLife.body[0]}</p>
		<MediaGrid class="c-interest-grid u-section-stack">
			{resume.interests.map((interest) => <MediaItem {...interest} />)}
		</MediaGrid>
	</SectionBand>

	<SectionBand id="hire-me" title={resume.sections.contact.title} tone="info" showRule={false} />

	<SectionBand id="contact" tone="white">
		<p class="c-dropcap">{resume.contactIntro}</p>
		<div class="l-two-panel c-contact-layout u-section-stack">
			<section aria-labelledby="contact-info-heading">
				<h2 id="contact-info-heading" class="u-center">Phil's Contact Info</h2>
				<ContactInfo items={resume.contactItems} />
			</section>

			<section aria-labelledby="contact-form-heading">
				<h2 id="contact-form-heading" class="u-center">Send Phil a Message</h2>
				<ContactForm action={resume.formAction} />
			</section>
		</div>
	</SectionBand>

	<SiteFooter links={[{ label: 'Blog', href: '/blog/' }, ...resume.socialLinks]} />
</ParallaxLayout>
