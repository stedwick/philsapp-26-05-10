---
import BackpackReveal from '../components/BackpackReveal.astro';
import IslandHero from '../components/IslandHero.astro';
import PortfolioCareer from '../components/PortfolioCareer.astro';
import PortfolioFinishing from '../components/PortfolioFinishing.astro';
import PortfolioPassport from '../components/PortfolioPassport.astro';
import PortfolioNav from '../components/PortfolioNav.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/portfolio.css';
import { getCollection } from 'astro:content';
import { icons } from '../data/site';
import { createResumeViewModel } from '../data/resume-data.mjs';

const [
	profileEntries,
	sectionEntries,
	skillEntries,
	experienceEntries,
	educationEntries,
	projectEntries,
	personalLinkEntries,
	contactEntries,
	assetEntries,
] = await Promise.all([
	getCollection('profile'),
	getCollection('sections'),
	getCollection('skills'),
	getCollection('experience'),
	getCollection('education'),
	getCollection('projects'),
	getCollection('personalLinks'),
	getCollection('contact'),
	getCollection('assets'),
]);

const resume = createResumeViewModel(
	{
		profile: profileEntries.map((entry) => entry.data),
		sections: sectionEntries.map((entry) => entry.data),
		skills: skillEntries.map((entry) => entry.data),
		experience: experienceEntries.map((entry) => entry.data),
		education: educationEntries.map((entry) => entry.data),
		projects: projectEntries.map((entry) => entry.data),
		personalLinks: personalLinkEntries.map((entry) => entry.data),
		contact: contactEntries.map((entry) => entry.data),
		assets: assetEntries.map((entry) => entry.data),
	},
	icons,
);
const resumeHref = resume.contactItems.find((item) => item.href?.endsWith('.pdf'))?.href
  ?? '/site-assets/Philip_Brocoum_resume.pdf';
---

<Layout viewportFitCover>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=IBM+Plex+Mono:wght@400;600&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </Fragment>
  <IslandHero profile={resume.profile} socialLinks={resume.socialLinks} chevronIcon={icons.ChevronDown} />

  <main class="pnw">
    <PortfolioNav resumeHref={resumeHref} />
    <BackpackReveal paragraphs={resume.sections.about.body}>
      <PortfolioPassport profile={resume.profile} skills={resume.skills} />
    </BackpackReveal>
    <PortfolioCareer
      career={resume.career}
      education={resume.education}
      careerSection={resume.sections.career}
      educationSection={resume.sections.education}
    />
    <PortfolioFinishing resume={resume} resumeHref={resumeHref} />
  </main>
</Layout>

<script>
  import { initPortfolio } from '../scripts/portfolio.js';

  initPortfolio();
</script>
