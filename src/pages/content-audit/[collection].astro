---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const routes = [
    { slug: 'blog-posts', title: 'Blog Posts', collection: 'blogPosts' },
    { slug: 'profile', title: 'About Me Profile', collection: 'profile' },
    { slug: 'sections', title: 'Resume Sections', collection: 'sections' },
    { slug: 'skills', title: 'Skills', collection: 'skills' },
    { slug: 'experience', title: 'My Career and Previous Jobs', collection: 'experience' },
    { slug: 'education', title: 'My Education', collection: 'education' },
    { slug: 'projects', title: 'My Fun Stuff', collection: 'projects' },
    { slug: 'personal-links', title: 'My Personal Life', collection: 'personalLinks' },
    { slug: 'contact', title: 'My Contact Info', collection: 'contact' },
    { slug: 'assets', title: 'Resume Assets', collection: 'assets' },
    { slug: 'blog-assets', title: 'Blog Assets', collection: 'blogAssets' },
    { slug: 'cleanup-notes', title: 'Cleanup Notes', collection: 'cleanupNotes' },
  ];

  return routes.map((route) => ({
    params: { collection: route.slug },
    props: { route },
  }));
}

const { route } = Astro.props;
const entries = (await getCollection(route.collection)).sort(
  (left, right) => (left.data.order ?? 0) - (right.data.order ?? 0),
);
const resumeAssets = await getCollection('assets');
const blogAssets = await getCollection('blogAssets');
const assetById = new Map(
  [...resumeAssets, ...blogAssets].map((entry) => [entry.data.id, entry.data]),
);

function assetPath(assetId) {
  return assetById.get(assetId)?.localPath || '';
}

function linkedEntries(entry) {
  return [
    ['portraitAssetId', 'Portrait'],
    ['portraitHighResAssetId', 'Portrait 2x'],
    ['logoAssetId', 'Logo'],
    ['logoHighResAssetId', 'Logo 2x'],
    ['screenshotAssetId', 'Screenshot'],
    ['screenshotHighResAssetId', 'Screenshot 2x'],
    ['iconAssetId', 'Icon'],
    ['iconHighResAssetId', 'Icon 2x'],
    ['resumeAssetId', 'Resume'],
  ]
    .map(([field, label]) => ({ field, label, path: assetPath(entry.data[field]) }))
    .filter((item) => item.path);
}

function dataTitle(data) {
  return data.title || data.company || data.name || data.id;
}
---

<Layout>
  <main class="audit-shell">
    <header>
      <p><a href="/content-audit/">Content Audit</a></p>
      <h1>{route.title}</h1>
      <p>{entries.length} entries from the <code>{route.collection}</code> collection.</p>
    </header>

    {
      entries.map((entry) => (
        <article id={entry.data.id} class="entry">
          <header>
            <h2>{dataTitle(entry.data)}</h2>
            <p><code>{entry.data.id}</code></p>
          </header>

          {route.collection === 'blogPosts' && (
            <section class="rendered-content">
              <p>
                <a href={entry.data.url}>Source post</a>
                {' '}
                <time datetime={entry.data.datePublished}>{entry.data.datePublished}</time>
              </p>
              <p>{entry.data.description}</p>
              <div set:html={entry.data.contentHtml} />
            </section>
          )}

          {route.collection === 'assets' || route.collection === 'blogAssets' ? (
            <section class="asset-preview">
              {entry.data.kind.includes('pdf') ? (
                <a href={entry.data.localPath}>Open local asset</a>
              ) : (
                <img src={entry.data.localPath} alt={entry.data.alt} />
              )}
              <p><a href={entry.data.sourceUrl}>Source asset</a></p>
            </section>
          ) : null}

          {route.collection !== 'assets' && route.collection !== 'blogAssets' && (
            <section class="asset-grid">
              {linkedEntries(entry).map((asset) => (
                <figure>
                  {asset.path.endsWith('.pdf') ? (
                    <a href={asset.path}>{asset.label}</a>
                  ) : (
                    <img src={asset.path} alt={`${asset.label} for ${dataTitle(entry.data)}`} />
                  )}
                  <figcaption>{asset.label}</figcaption>
                </figure>
              ))}
            </section>
          )}

          <details open>
            <summary>Collection Data</summary>
            <pre>{JSON.stringify(entry.data, null, 2)}</pre>
          </details>
        </article>
      ))
    }
  </main>
</Layout>

<style>
  .audit-shell {
    max-width: 1040px;
    margin: 0 auto;
    padding: 32px 20px;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  .entry {
    border-top: 1px solid #d6d6d6;
    padding: 24px 0;
  }

  .rendered-content,
  .asset-preview,
  .asset-grid {
    margin: 16px 0;
  }

  .rendered-content img,
  .asset-preview img,
  .asset-grid img {
    display: block;
    max-width: min(100%, 520px);
    height: auto;
    border: 1px solid #ddd;
  }

  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
  }

  .asset-grid figure {
    margin: 0;
  }

  pre {
    overflow: auto;
    padding: 16px;
    background: #f5f5f5;
    border: 1px solid #ddd;
  }
</style>
