---
import Layout from '../layouts/Layout.astro';

// Temporary page for picking the new --color-info accent. Delete after a winner is chosen.
const candidates = [
	{ name: 'Cyan (current)', hex: '#06b6d4' },
	{ name: 'Sky', hex: '#0ea5e9' },
	{ name: 'Blue', hex: '#3b82f6' },
	{ name: 'Indigo', hex: '#6366f1' },
	{ name: 'Violet', hex: '#8b5cf6' },
	{ name: 'Purple', hex: '#a855f7' },
	{ name: 'Teal', hex: '#14b8a6' },
	{ name: 'Emerald', hex: '#10b981' },
	{ name: 'Rose', hex: '#f43f5e' },
	{ name: 'Orange', hex: '#f97316' },
];
---

<Layout title="Color Picker - Philip Brocoum">
	<main class="l-container color-pick">
		<h1>Pick an accent color</h1>
		<p>
			Each candidate shown as the hero button on a dark strip and as a
			full-width section band with white text.
		</p>
		{
			candidates.map((color) => (
				<section class="color-pick__row">
					<h2 class="color-pick__label">
						{color.name} <code>{color.hex}</code>
					</h2>
					<div class="color-pick__dark-strip">
						<a
							class="c-button c-button--primary c-button--md"
							style={`background-color: ${color.hex}; border-color: ${color.hex};`}
							href="#"
						>
							Contact Me
						</a>
					</div>
					<div class="color-pick__band" style={`background-color: ${color.hex};`}>
						<h3>Contact Me</h3>
					</div>
				</section>
			))
		}
	</main>
</Layout>

<style>
	.color-pick {
		min-height: 100svh;
		padding-block: var(--space-5);
		background-color: var(--color-surface);
		color: var(--color-on-surface);
	}

	.color-pick__row {
		margin-block: var(--space-5);
	}

	.color-pick__label {
		margin-bottom: var(--space-3);
		font-size: 1.25rem;
	}

	.color-pick__dark-strip {
		display: grid;
		justify-items: center;
		padding: var(--space-5);
		background-color: var(--color-dark);
	}

	.color-pick__band {
		padding: var(--space-5);
		text-align: center;
		color: var(--color-white);
	}

	.color-pick__band h3 {
		margin: 0;
		font-size: 2rem;
	}
</style>
