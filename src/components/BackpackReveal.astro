---
interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
---

<div class="pnw-reveal" data-pnw-reveal>
  <div class="pnw-reveal__track" aria-hidden="true">
    <div class="pnw-reveal__pack">
      <div class="pnw-reveal__insert" data-pnw-insert></div>
      <img class="pnw-reveal__flap" src="/site-assets/pnw/backpack-flap.webp" alt="" width="420" height="260" decoding="async" fetchpriority="low" />
      <img class="pnw-reveal__body" src="/site-assets/pnw/backpack-body.webp" alt="" width="560" height="612" decoding="async" fetchpriority="low" />
    </div>
  </div>

  <section id="about" class="pnw-welcome-wrap" aria-labelledby="welcome-title">
    <div class="pnw-welcome__no"><span class="pnw-head__no">Nº 01 · Welcome</span></div>
    <div class="pnw-obj pnw-welcome" style="--r:-1.2deg">
      <div class="pnw-paper pnw-welcome__card" data-g="card" data-ink="var(--t-ultra)">
        <div class="pnw-welcome__top">
          <p class="pnw-lbl">Post card · PDX</p>
          <div class="pnw-welcome__postage" aria-hidden="true">
            <svg class="pnw-welcome__postmark pnw-inked" viewBox="0 0 230 120">
              <defs><path id="pnw-pm" d="M62,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
              <circle cx="62" cy="60" r="54" fill="none" stroke="currentColor" stroke-width="2.5" />
              <circle cx="62" cy="60" r="33" fill="none" stroke="currentColor" stroke-width="1.2" />
              <text font-family="Cinzel" font-weight="700" font-size="10.5" letter-spacing="2" fill="currentColor"><textPath href="#pnw-pm">PORTLAND · OREGON · PORTLAND · OREGON ·</textPath></text>
              <text x="62" y="57" text-anchor="middle" font-family="Cinzel" font-weight="900" font-size="15" fill="currentColor">PDX</text>
              <text x="62" y="72" text-anchor="middle" font-family="Cinzel" font-weight="700" font-size="8" letter-spacing="1.5" fill="currentColor">SINCE 2007</text>
              <path d="M120 40 q6 -6 12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 M120 60 q6 -6 12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 M120 80 q6 -6 12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0" fill="none" stroke="currentColor" stroke-width="2.5" />
            </svg>
            <div class="pnw-welcome__stamp">
              <div class="pnw-welcome__stamp-in">
                <img src="/parallax/mountain.webp" alt="" width="2048" height="1152" loading="lazy" decoding="async" />
                <span>Mt Hood</span>
              </div>
            </div>
          </div>
        </div>
        <h2 id="welcome-title" class="pnw-welcome__hi">Welcome!</h2>
        <div class="pnw-welcome__body">
          {paragraphs.slice(0, 1).map((paragraph) => <p>{paragraph}</p>)}
          {paragraphs.length > 1 && (
            <details class="pnw-welcome__ps">
              <summary>P.S. What I'm doing today</summary>
              {paragraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}
            </details>
          )}
        </div>
        <p class="pnw-welcome__sig" aria-hidden="true">Philip</p>
        <div class="pnw-uvl" aria-hidden="true">
          <svg viewBox="-50 -50 100 100" style="left:-12%;bottom:-10%;width:45%"><path data-rose="32,8,18,12" /></svg>
          <span class="t" style="right:8%;bottom:1.2rem;font-size:.6rem">GENUINE · PORTLAND · OREGON</span>
        </div>
      </div>
    </div>
  </section>
  <slot />
</div>

<style>
  .pnw-reveal {
    position: relative;
    isolation: isolate;
    padding-block-start: 3rem;
  }
  .pnw-reveal__track {
    position: relative;
    pointer-events: none;
  }
  .pnw-reveal__pack {
    width: clamp(8.5rem, 41vw, 15rem);
    margin-inline: auto;
    display: grid;
    align-items: end;
  }
  .pnw-reveal__insert {
    display: none;
    position: absolute;
    inset: 15% 18% auto;
    block-size: 48%;
    background: var(--t-paper);
    border: 2px solid var(--t-paper2);
    border-radius: .16rem;
    transform: translateY(var(--insert-rise, 0px));
  }
  .pnw-reveal__insert[data-passport] {
    border: .3rem solid var(--color-tender-post);
    border-radius: .35rem;
  }
  .pnw-reveal__pack img {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    display: block;
    z-index: 1;
  }
  .pnw-reveal__pack img.pnw-reveal__flap {
    width: 77%;
    margin-inline: auto;
    align-self: start;
    translate: 0 8%;
    transform-origin: 50% 14%;
    transform: translateY(var(--flap-rise, -1rem)) scaleY(var(--flap-scale, .52));
    z-index: 2;
  }
  .pnw-reveal[data-pack-missing] .pnw-reveal__track { display: none; }
  .pnw-reveal[data-pack-missing] { padding-block-start: 4rem; }
  .pnw-welcome-wrap {
    position: relative;
    padding: 0 clamp(1.4rem, 4vw, 3.5rem) clamp(3rem, 7vw, 5rem);
  }
  .pnw-welcome { max-inline-size: 48rem; margin-inline: auto; }
  .pnw-welcome__no { position: relative; z-index: 4; max-inline-size: 48rem; margin: 0 auto 1.4rem; display: grid; }
  .pnw-welcome__card {
    padding: clamp(1.5rem, 5vw, 3.2rem) clamp(1.5rem, 6vw, 3.4rem) clamp(1.4rem, 4vw, 2.6rem);
    border-radius: 4px;
  }
  .pnw-welcome__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    color: var(--t-ultra);
  }
  .pnw-welcome__top .pnw-lbl { margin: .4rem 0 0; }
  .pnw-welcome__postage { position: relative; flex: none; display: flex; align-items: center; }
  .pnw-welcome__postmark {
    position: absolute;
    right: 2.6rem;
    top: .6rem;
    width: 9.5rem;
    color: color-mix(in srgb, var(--t-ink) 75%, transparent);
    transform: rotate(-8deg);
    z-index: 2;
  }
  .pnw-welcome__stamp {
    width: 4.6rem;
    padding: 5px;
    background: radial-gradient(circle at 5px 5px, transparent 3.4px, var(--t-paper3) 3.9px) -5px -5px / 10px 10px;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / .25));
    transform: rotate(3deg);
  }
  .pnw-welcome__stamp-in {
    position: relative;
    aspect-ratio: .8;
    overflow: hidden;
    background: linear-gradient(var(--color-night-sky), color-mix(in srgb, var(--t-verm) 45%, var(--t-gold)) 70%);
    box-shadow: inset 0 0 0 3px var(--t-paper3), inset 0 0 0 4px var(--t-verm);
  }
  .pnw-welcome__stamp-in img {
    position: absolute;
    left: 50%;
    top: 4%;
    width: 330%;
    max-width: none;
    height: auto;
    transform: translate(-50%, -14%);
  }
  .pnw-welcome__stamp-in span {
    position: absolute;
    inset: auto 0 5px;
    text-align: center;
    font: 900 .5rem/1 var(--f-display);
    letter-spacing: .14em;
    color: var(--t-paper3);
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgb(0 0 0 / .6);
  }
  .pnw-welcome__hi {
    margin: .6rem 0 .8rem;
    font: 600 clamp(3.2rem, 13vw, 5rem)/.9 var(--f-hand);
    color: var(--t-ultra);
    transform: rotate(-2deg);
    transform-origin: left;
  }
  .pnw-welcome__body {
    --line: 1.75rem;
    font-size: 1.04rem;
    line-height: var(--line);
    color: var(--t-ink);
    background-image: repeating-linear-gradient(transparent 0 calc(var(--line) - 1px), color-mix(in srgb, var(--t-ultra) 14%, transparent) calc(var(--line) - 1px) var(--line));
  }
  .pnw-welcome__body p { margin: 0 0 var(--line); line-height: var(--line); max-inline-size: 62ch; }
  .pnw-welcome__body p + p { margin-top: 0; }
  .pnw-welcome__ps summary {
    cursor: pointer;
    list-style: none;
    font: 600 1.5rem/var(--line) var(--f-hand);
    color: var(--t-ultra);
  }
  .pnw-welcome__ps summary::-webkit-details-marker { display: none; }
  .pnw-welcome__ps summary::after { content: ' ↓'; }
  .pnw-welcome__ps[open] summary::after { content: ' ↑'; }
  .pnw-welcome__ps p { margin: 0; }
  .pnw-welcome__body p:last-child { margin-bottom: 0; }
  .pnw-welcome__sig {
    margin: .8rem 0 0;
    text-align: right;
    font: 600 2.4rem/1 var(--f-hand);
    color: var(--t-ultra);
    transform: rotate(-4deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pnw-reveal[data-pack-animated] { padding-block-start: 1rem; }
    .pnw-reveal[data-pack-animated] .pnw-welcome-wrap { position: relative; z-index: 4; }
    .pnw-reveal[data-pack-animated] .pnw-reveal__track {
      position: absolute;
      inset: 0;
      z-index: 3;
    }
    .pnw-reveal[data-pack-animated] .pnw-reveal__pack {
      position: sticky;
      top: calc(100svh - var(--pnw-pack-height, 12rem) * .70);
      opacity: var(--pack-opacity, 0);
      transform: translateY(var(--pack-drop, 0px));
    }
    .pnw-reveal[data-pack-animated] .pnw-reveal__insert { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pnw-reveal__pack img.pnw-reveal__flap { transform: translateY(-1rem) scaleY(.52); }
  }
</style>
