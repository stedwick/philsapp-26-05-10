---
interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
---

<div class="pnw-reveal" data-pnw-reveal>
  <div class="pnw-reveal__track" aria-hidden="true">
    <div class="pnw-reveal__pack">
      <div class="pnw-reveal__insert" data-pnw-insert></div>
      <img class="pnw-reveal__flap" src="/site-assets/pnw/backpack-flap.webp" alt="" width="420" height="260" decoding="async" />
      <img class="pnw-reveal__body" src="/site-assets/pnw/backpack-body.webp" alt="" width="560" height="612" decoding="async" />
    </div>
  </div>

  <section id="about" class="pnw-section pnw-welcome-section" aria-labelledby="welcome-title">
    <div class="pnw-wrap">
      <header class="pnw-head">
        <div class="pnw-head__meta">
          <span class="pnw-head__no">Nº 01 · Welcome</span>
          <span class="pnw-head__rule" aria-hidden="true"></span>
        </div>
        <h2 id="welcome-title">Welcome</h2>
        <p class="pnw-head__lead">Lead software engineer in Portland, building with Ruby, TypeScript, and AI since 2007.</p>
      </header>

      <div class="pnw-obj pnw-welcome">
        <div class="pnw-paper pnw-welcome__card" data-g="card" data-ink="var(--t-ultra)">
          <div class="pnw-welcome__top">
            <p class="pnw-lbl">Post card · Portland, OR</p>
            <div class="pnw-welcome__postage" aria-hidden="true">
              <svg class="pnw-welcome__postmark pnw-inked" viewBox="0 0 230 120">
                <defs><path id="pnw-pm" d="M62,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
                <circle cx="62" cy="60" r="54" fill="none" stroke="currentColor" stroke-width="2.5" />
                <circle cx="62" cy="60" r="33" fill="none" stroke="currentColor" stroke-width="1.2" />
                <text font-family="Cinzel" font-weight="700" font-size="10.5" letter-spacing="2" fill="currentColor"><textPath href="#pnw-pm">PORTLAND · OREGON · PORTLAND · OREGON ·</textPath></text>
                <text x="62" y="57" text-anchor="middle" font-family="Cinzel" font-weight="900" font-size="15" fill="currentColor">PDX</text>
                <text x="62" y="72" text-anchor="middle" font-family="Cinzel" font-weight="700" font-size="8" letter-spacing="1.5" fill="currentColor">SINCE 2007</text>
                <path d="M120 40 q6 -6 12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 M120 60 q6 -6 12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 M120 80 q6 -6 12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0" fill="none" stroke="currentColor" stroke-width="2.5" />
              </svg>
              <div class="pnw-welcome__stamp">
                <div class="pnw-welcome__stamp-in">
                  <img src="/parallax/mountain.webp" alt="" width="2048" height="1152" loading="lazy" decoding="async" />
                  <span>Mt Hood</span>
                </div>
              </div>
            </div>
          </div>

          <div class="pnw-welcome__layout">
            <div class="pnw-welcome__main">
              <p class="pnw-welcome__hi" aria-hidden="true">Hi, I'm Philip.</p>
              <div class="pnw-welcome__body">
                {paragraphs.slice(0, 1).map((paragraph) => <p>{paragraph}</p>)}
                {paragraphs.length > 1 && (
                  <details class="pnw-welcome__ps">
                    <summary>P.S. What I'm doing today</summary>
                    <div class="pnw-welcome__ps-body">
                      {paragraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}
                    </div>
                  </details>
                )}
              </div>
              <p class="pnw-welcome__sig" aria-hidden="true">Philip</p>
            </div>

            <aside class="pnw-welcome__aside" aria-label="At a glance">
              <p class="pnw-lbl pnw-welcome__aside-title">Dispatched from</p>
              <dl class="pnw-welcome__facts">
                <div><dt>Location</dt><dd>Portland, Oregon</dd></div>
                <div><dt>In software</dt><dd>Since 2007 (18+ years)</dd></div>
                <div><dt>Leadership</dt><dd>8 years manager &amp; lead</dd></div>
                <div><dt>Current role</dt><dd>Lead Engineer, Olio Apps</dd></div>
              </dl>
            </aside>
          </div>

          <div class="pnw-uvl" aria-hidden="true">
            <svg viewBox="-50 -50 100 100" style="left:-10%;bottom:-10%;width:38%"><path data-rose="32,8,18,12" /></svg>
            <span class="t" style="right:1rem;bottom:.4rem;font-size:.58rem">GENUINE · PORTLAND · OREGON</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
<slot />

<style>
  .pnw-reveal {
    position: relative;
    isolation: isolate;
  }
  .pnw-reveal__track {
    position: relative;
    pointer-events: none;
  }
  .pnw-reveal__pack {
    width: clamp(8.5rem, 41vw, 15rem);
    margin-inline: auto;
    display: grid;
    align-items: end;
  }
  .pnw-reveal__insert {
    display: none;
    position: absolute;
    inset: 15% 18% auto;
    block-size: 48%;
    background: var(--t-paper);
    border: 2px solid var(--t-paper2);
    border-radius: .16rem;
    transform: translateY(var(--insert-rise, 0px));
  }
  .pnw-reveal__pack img {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    display: block;
    z-index: 1;
  }
  .pnw-reveal__pack img.pnw-reveal__flap {
    width: 77%;
    margin-inline: auto;
    align-self: start;
    translate: 0 8%;
    transform-origin: 50% 14%;
    transform: translateY(var(--flap-rise, -1rem)) scaleY(var(--flap-scale, .52));
    z-index: 2;
  }
  .pnw-reveal[data-pack-missing] .pnw-reveal__track { display: none; }

  .pnw-welcome-section {
    position: relative;
    z-index: 4;
    padding-block-start: clamp(1.75rem, 4.5vw, 3.25rem);
  }
  .pnw-welcome { max-inline-size: 72rem; margin-inline: auto; }
  .pnw-welcome__card {
    padding: clamp(1.3rem, 4.5vw, 2.8rem) clamp(1.2rem, 5vw, 3rem) clamp(1.4rem, 4vw, 2.5rem);
    border-radius: 4px;
  }
  .pnw-welcome__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: .5rem .75rem;
    color: var(--t-ultra);
    margin-bottom: .75rem;
  }
  .pnw-welcome__top .pnw-lbl { margin: 0; }
  .pnw-welcome__postage {
    position: relative;
    flex: none;
    margin-left: auto;
    display: inline-flex;
    align-items: center;
  }
  .pnw-welcome__postmark {
    position: relative;
    width: 5.8rem;
    margin-right: -.85rem;
    color: color-mix(in srgb, var(--t-ink) 72%, transparent);
    z-index: 2;
    pointer-events: none;
  }
  .pnw-welcome__stamp {
    width: 3.7rem;
    padding: 4px;
    background: radial-gradient(circle at 5px 5px, transparent 3.4px, var(--t-paper3) 3.9px) -5px -5px / 10px 10px;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / .25));
  }
  .pnw-welcome__stamp-in {
    position: relative;
    aspect-ratio: .8;
    overflow: hidden;
    background: linear-gradient(var(--color-night-sky), color-mix(in srgb, var(--t-verm) 45%, var(--t-gold)) 70%);
    box-shadow: inset 0 0 0 3px var(--t-paper3), inset 0 0 0 4px var(--t-verm);
  }
  .pnw-welcome__stamp-in img {
    position: absolute;
    left: 50%;
    top: 4%;
    width: 330%;
    max-width: none;
    height: auto;
    transform: translate(-50%, -14%);
  }
  .pnw-welcome__stamp-in span {
    position: absolute;
    inset: auto 0 5px;
    text-align: center;
    font: 900 .48rem/1 var(--f-display);
    letter-spacing: .12em;
    color: var(--t-paper3);
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgb(0 0 0 / .6);
  }
  .pnw-welcome__layout {
    display: grid;
    gap: 1.5rem 2.5rem;
    align-items: start;
  }
  .pnw-welcome__hi {
    margin: .2rem 0 .8rem;
    font: 600 clamp(2.4rem, 10vw, 3.8rem)/.95 var(--f-hand);
    color: var(--t-ultra);
  }
  .pnw-welcome__body {
    --line: 1.75rem;
    font-size: 1.03rem;
    line-height: var(--line);
    color: var(--t-ink);
    background-image: repeating-linear-gradient(transparent 0 calc(var(--line) - 1px), color-mix(in srgb, var(--t-ultra) 14%, transparent) calc(var(--line) - 1px) var(--line));
  }
  .pnw-welcome__body p { margin: 0 0 var(--line); line-height: var(--line); max-inline-size: 62ch; }
  .pnw-welcome__body p + p { margin-top: 0; }
  .pnw-welcome__ps { margin-top: .25rem; }
  .pnw-welcome__ps summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-block-size: 2.75rem;
    padding: .35rem .9rem;
    border: 1px solid color-mix(in srgb, var(--t-ultra) 40%, transparent);
    border-radius: 4px;
    background: color-mix(in srgb, var(--t-ultra) 7%, transparent);
    font: 600 .95rem/1.3 var(--f-text);
    color: var(--t-ultra);
    transition: background .2s, border-color .2s;
  }
  .pnw-welcome__ps summary:hover {
    background: color-mix(in srgb, var(--t-ultra) 13%, transparent);
    border-color: var(--t-ultra);
  }
  .pnw-welcome__ps summary::-webkit-details-marker { display: none; }
  .pnw-welcome__ps summary::after { content: '↓'; font-family: var(--f-mono); font-size: .85em; }
  .pnw-welcome__ps[open] summary::after { content: '↑'; }
  .pnw-welcome__ps-body { padding-top: .75rem; }
  .pnw-welcome__ps p { margin: 0; }
  .pnw-welcome__body p:last-child { margin-bottom: 0; }
  .pnw-welcome__sig {
    margin: .9rem 0 0;
    text-align: right;
    font: 600 2.2rem/1 var(--f-hand);
    color: var(--t-ultra);
  }
  .pnw-welcome__aside {
    border-top: 1px solid color-mix(in srgb, var(--t-ultra) 24%, transparent);
    padding-top: 1.1rem;
  }
  .pnw-welcome__aside-title {
    margin: 0 0 .75rem;
    color: var(--t-ultra);
  }
  .pnw-welcome__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem 1rem;
    margin: 0;
  }
  .pnw-welcome__facts dt {
    font: 600 .66rem/1.2 var(--f-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--t-ink-soft);
    margin-bottom: .15rem;
  }
  .pnw-welcome__facts dd {
    margin: 0;
    font: 500 .95rem/1.35 var(--f-text);
    color: var(--t-ink);
  }

  @media (min-width: 30rem) {
    .pnw-welcome__postmark { width: 7.4rem; margin-right: -1rem; }
    .pnw-welcome__stamp { width: 4.4rem; padding: 5px; }
  }
  @media (min-width: 36rem) {
    .pnw-welcome__postmark { width: 8.6rem; margin-right: -1.1rem; }
  }
  @media (min-width: 54rem) {
    .pnw-welcome__layout {
      grid-template-columns: minmax(0, 1.65fr) minmax(15rem, .85fr);
    }
    .pnw-welcome__aside {
      border-top: 0;
      border-left: 1px solid color-mix(in srgb, var(--t-ultra) 24%, transparent);
      padding-top: 0;
      padding-left: 2rem;
    }
    .pnw-welcome__facts { grid-template-columns: minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pnw-reveal__track {
      position: absolute;
      inset: 0;
      z-index: 2;
    }
    .pnw-reveal__pack {
      position: sticky;
      top: calc(100svh - var(--pnw-pack-height, 12rem) * .70);
      opacity: var(--pack-opacity, 0);
      transform: translateY(var(--pack-drop, 0px));
    }
    .pnw-reveal[data-pack-animated] .pnw-reveal__insert { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pnw-reveal__track { display: none; }
  }
</style>
