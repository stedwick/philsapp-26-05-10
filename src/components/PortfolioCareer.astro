---
import { Image } from 'astro:assets';
import type { createResumeViewModel } from '../data/resume-data.mjs';

type Resume = ReturnType<typeof createResumeViewModel>;
type Section = NonNullable<Resume['sections']['career']>;

interface Props {
  career: Resume['career'];
  education: Resume['education'];
  careerSection: Section;
  educationSection: Section;
}

const { career, education, careerSection, educationSection } = Astro.props;
const diplomaInks = ['var(--t-ultra)', 'var(--t-green)', 'var(--t-brown)'];
const diplomaKicker = ['Certificate of Record', 'Certificate of Record', 'Record of Service'];

// When the paragraph only repeats the linked titles below it, keep its lead-in.
function shortBody(body: string, actions: { label: string }[]) {
  const repeats = actions.some((action) => action.label.length > 12 && body.includes(action.label.replace(/[",.]/g, '').slice(0, 20)));
  return repeats && body.includes(':') ? body.slice(0, body.indexOf(':') + 1) : body;
}
// "B.S. in Mathematics (class of 2005)" -> degree + class
function splitDegree(text = '') {
  const match = text.match(/^(.*?)\s*\((.*)\)$/);
  return match ? { degree: match[1], year: match[2].replaceAll(' – ', ' to ') } : { degree: text, year: '' };
}
---

<section class="pnw-section" id="career" aria-labelledby="career-heading">
  <div class="pnw-wrap">
    <header class="pnw-head">
      <div class="pnw-head__meta">
        <span class="pnw-head__no">Nº 03 · Career</span>
        <span class="pnw-head__rule" aria-hidden="true"></span>
      </div>
      <h2 id="career-heading">{careerSection.title}</h2>
      <p class="pnw-head__lead">18 years building web and mobile products and leading engineering teams, from New York to Portland.</p>
    </header>

    <div class="pnw-obj pnw-cpost">
      <div class="pnw-paper pnw-cpost__card" data-g="card" data-ink="var(--t-green)">
        <div class="pnw-cpost__msg">
          <p class="pnw-lbl">Post card · New York to Portland</p>
          <p class="pnw-cpost__title" aria-hidden="true">Since 2007,</p>
          {careerSection.body.slice(0, 1).map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="pnw-cpost__addr" aria-label="Career summary">
          <div class="pnw-cpost__stamp" aria-hidden="true"><div><span>18</span><small>years</small></div></div>
          <p>18+ years building software</p>
          <p>8 years engineering leadership</p>
          <p>NYC (2007 to 2016) · PDX (2016 to Present)</p>
        </div>
        <div class="pnw-uvl" aria-hidden="true">
          <svg viewBox="-50 -50 100 100" style="right:4%;top:4%;width:28%"><path data-rose="30,7,16,12" /></svg>
          <span class="t" style="left:1.4rem;bottom:.9rem;font-size:.62rem">VERIFIED · 18 YEARS · NYC TO PDX</span>
        </div>
      </div>
    </div>

    <div class="pnw-sheets">
      {career.map(({ action, body, href, image, links, logo, metaLabel, roles, siteLabel, title }, index) => {
        return (
          <article class="pnw-obj pnw-sheet-obj">
            <div class="pnw-sheet">
              <div class="pnw-sheet__head">
                <span>Career · Sheet Nº {String(index + 1).padStart(2, '0')}</span>
              </div>
              {image && (
                <figure class="pnw-polaroid">
                  <a href={href} tabindex="-1">
                    <Image src={image.src} srcset={image.srcSet} alt={image.alt} width={600} height={341} loading="lazy" />
                  </a>
                  <figcaption>{siteLabel}</figcaption>
                </figure>
              )}
              <h3 class="pnw-sheet__co">
                {logo && <Image src={logo.src} srcset={logo.srcSet} alt="" width={36} height={36} loading="lazy" />}
                <span>{title}</span>
              </h3>
              {metaLabel && <p class="pnw-sheet__loc">{metaLabel}</p>}
              <ul class="pnw-sheet__roles" aria-label={`${title} roles`}>
                {roles.map((role) => (
                  <li>
                    <b>{role.title}</b>
                    {role.dates && <span class="pnw-sheet__meta">{role.dates}</span>}
                  </li>
                ))}
              </ul>
              <p class="pnw-sheet__body">{body}</p>
              {links.length > 0 && (
                <p class="pnw-sheet__links"><span>Portfolio:</span> {links.map((link, i) => <>{i > 0 && ' · '}<a href={link.href}>{link.label}</a></>)}</p>
              )}
              <a class="pnw-cta pnw-sheet__visit" href={href}>{action}&nbsp;↗</a>
              <div class="pnw-uvl" aria-hidden="true">
                <span class="t" style="right:1rem;top:1rem;font-size:.52rem;letter-spacing:.16em">VERIFIED · {title.toUpperCase()} · PB</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section class="pnw-section" id="education-projects" aria-labelledby="education-heading">
  <div class="pnw-wrap">
    <header class="pnw-head">
      <div class="pnw-head__meta">
        <span class="pnw-head__no">Nº 04 · Education</span>
        <span class="pnw-head__rule" aria-hidden="true"></span>
      </div>
      <h2 id="education-heading">{educationSection.title}</h2>
      {educationSection.body.slice(0, 1).map((paragraph) => <p class="pnw-head__lead">{paragraph}</p>)}
    </header>

    <div class="pnw-diplomas">
      {education.map((item, index) => {
        const { degree, year } = splitDegree(item.addendum);
        const ink = diplomaInks[index % diplomaInks.length];
        return (
          <article class="pnw-obj pnw-dipl-obj" style={`--dink:${ink}`}>
            <div class="pnw-paper pnw-dipl" data-g="dipl" data-ink={ink}>
              <p class="pnw-dipl__k">{diplomaKicker[index] ?? diplomaKicker[0]}</p>
              <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
              {degree && <p class="pnw-dipl__deg">{degree}</p>}
              {year && <p class="pnw-dipl__cls">{year}</p>}
              <div class="pnw-dipl__seal" aria-hidden="true"><svg viewBox="-50 -50 100 100"><path data-rose="30,6,14,16" /></svg></div>
              <div class="pnw-uvl" aria-hidden="true">
                <svg viewBox="-50 -50 100 100" style="left:25%;top:10%;width:50%"><path data-rose="34,7,24,24" /></svg>
                <span class="t" style="left:1rem;bottom:.8rem;font-size:.52rem;letter-spacing:.16em">OFFICIAL · ACADEMIC · RECORD</span>
              </div>
            </div>
            {(item.body || item.actions.length > 0) && (
              <div class="pnw-paper pnw-dipl__fine">
                {item.body && <p>{shortBody(item.body, item.actions)}</p>}
                {item.actions.length > 0 && (
                  <ul>
                    {item.actions.map((action) => <li><a href={action.href}>{action.label.replace(/[,.]+(["”]?)$/, '$1')} ↗</a></li>)}
                  </ul>
                )}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* ---- career postcard ---- */
  .pnw-cpost { max-inline-size: 72rem; margin: 0 auto clamp(2.5rem, 6vw, 4rem); }
  .pnw-cpost__card {
    display: grid;
    gap: 1.4rem;
    padding: clamp(1.4rem, 4.5vw, 2.8rem) clamp(1.2rem, 5vw, 3rem) 2.4rem;
    border-radius: 4px;
  }
  .pnw-cpost__msg .pnw-lbl { margin: 0; color: var(--t-green); }
  .pnw-cpost__title {
    margin: .3rem 0 .7rem;
    font: 600 clamp(2.1rem, 8vw, 3.2rem)/.95 var(--f-hand);
    color: var(--t-green);
  }
  .pnw-cpost__msg p:not(.pnw-lbl, .pnw-cpost__title) { margin: 0 0 .9em; line-height: 1.65; max-inline-size: 62ch; }
  .pnw-cpost__addr {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0;
    padding: .2rem 5rem 0 0;
    font: 500 .98rem/1.4 var(--f-text);
    color: var(--t-ultra);
  }
  .pnw-cpost__addr p {
    margin: 0;
    padding: .55rem 0 .4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--t-ink) 28%, transparent);
  }
  .pnw-cpost__stamp {
    position: absolute;
    right: 0;
    top: 0;
    width: 4.3rem;
    padding: 5px;
    background: radial-gradient(circle at 5px 5px, transparent 3.4px, var(--t-paper3) 3.9px) -5px -5px / 10px 10px;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / .25));
  }
  .pnw-cpost__stamp > div {
    display: grid;
    place-content: center;
    aspect-ratio: .82;
    color: var(--t-paper3);
    font-family: var(--f-display);
    text-align: center;
    background: var(--t-green);
    box-shadow: inset 0 0 0 3px var(--t-paper3), inset 0 0 0 4px var(--t-green);
  }
  .pnw-cpost__stamp span { font-weight: 900; font-size: 1.65rem; line-height: 1; }
  .pnw-cpost__stamp small { font-size: .48rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; }

  /* ---- lined sheets (US Letter) ---- */
  .pnw-sheets {
    display: grid;
    gap: clamp(1.6rem, 4vw, 2.2rem);
    margin-inline: auto;
  }
  .pnw-sheet-obj { display: flex; }
  .pnw-sheet {
    --line: 1.75rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-block-size: 0;
    padding: var(--line) 1rem var(--line) 2.25rem;
    border-radius: 3px;
    color: var(--t-ink);
    background:
      radial-gradient(circle at .72rem 3.5rem, color-mix(in srgb, var(--color-tender-pine) 70%, transparent) 0 .32rem, transparent .37rem),
      radial-gradient(circle at .72rem 50%, color-mix(in srgb, var(--color-tender-pine) 70%, transparent) 0 .32rem, transparent .37rem),
      radial-gradient(circle at .72rem calc(100% - 3.5rem), color-mix(in srgb, var(--color-tender-pine) 70%, transparent) 0 .32rem, transparent .37rem),
      linear-gradient(90deg, transparent 1.5rem, color-mix(in srgb, var(--t-verm) 45%, var(--t-paper3)) 1.5rem calc(1.5rem + 2px), transparent calc(1.5rem + 2px)),
      var(--fibre),
      var(--t-paper3);
    box-shadow: 0 1px 0 var(--t-paper2), 0 3px 0 var(--t-paper3), 0 4px 0 var(--t-paper2);
    line-height: var(--line);
  }
  .pnw-sheet::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity .5s;
  }
  .pnw-sheet > :where(:not(.pnw-uvl)) { position: relative; z-index: 1; }
  :global(.pnw[data-uv='true']) .pnw-sheet::after {
    background: radial-gradient(120% 90% at 50% 0%, rgb(139 92 246 / .16), transparent 72%);
    opacity: 1;
  }
  :global(.pnw[data-uv='true']) .pnw-sheet {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--t-uv) 40%, transparent), 0 0 28px color-mix(in srgb, var(--t-uv) 18%, transparent);
  }
  @media (prefers-color-scheme: dark) {
    :global(.pnw:not([data-uv='false'])) .pnw-sheet::after {
      background: radial-gradient(120% 90% at 50% 0%, rgb(139 92 246 / .16), transparent 72%);
      opacity: 1;
    }
    :global(.pnw:not([data-uv='false'])) .pnw-sheet {
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--t-uv) 40%, transparent), 0 0 28px color-mix(in srgb, var(--t-uv) 18%, transparent);
    }
  }

  .pnw-sheet__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font: 700 .66rem/var(--line) var(--f-display);
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--t-verm);
    margin-bottom: calc(var(--line) * .5);
  }
  .pnw-polaroid {
    position: relative;
    align-self: stretch;
    inline-size: 100%;
    margin: .4rem 0 var(--line);
    padding: .55rem .55rem .65rem;
    background: var(--t-paper3);
    border: 1px solid color-mix(in srgb, var(--t-ink) 12%, transparent);
    border-radius: 2px;
    box-shadow: 0 2px 0 rgb(0 0 0 / .06), 0 12px 22px rgb(0 0 0 / .18);
    transition: transform .35s var(--spring);
    line-height: 1.2;
  }
  .pnw-polaroid:hover { transform: translateY(-2px); }
  .pnw-polaroid::before {
    content: '';
    position: absolute;
    top: -.65rem;
    left: 50%;
    width: 5.5rem;
    height: 1.35rem;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--t-gold) 45%, transparent);
    box-shadow: 0 1px 2px rgb(0 0 0 / .12);
    z-index: 2;
  }
  .pnw-polaroid img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 600 / 341;
    object-fit: cover;
    object-position: top;
    border: 1px solid color-mix(in srgb, var(--t-ink) 10%, transparent);
  }
  .pnw-polaroid figcaption {
    margin-top: .5rem;
    text-align: center;
    font: 400 .72rem/1.1 var(--f-mono);
    color: var(--t-ink-soft);
    overflow-wrap: anywhere;
  }
  .pnw-sheet__co {
    display: flex;
    align-items: center;
    gap: .6rem;
    margin: 0;
    font: 900 clamp(1.45rem, 5.2vw, 2rem)/1.15 var(--f-display);
    color: var(--t-green);
  }
  .pnw-sheet__co img { inline-size: 1.65rem; block-size: 1.65rem; object-fit: contain; flex: none; }
  .pnw-sheet__loc {
    margin: .2rem 0 .5rem;
    font: 600 .74rem/1.3 var(--f-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--t-ink-soft);
  }
  .pnw-sheet__roles {
    margin: 0 0 var(--line);
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--t-ultra) 18%, transparent);
  }
  .pnw-sheet__roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: .15rem .75rem;
    padding: .35rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--t-ultra) 18%, transparent);
    line-height: 1.35;
  }
  .pnw-sheet__roles b {
    font: italic 500 1.04rem/1.35 var(--f-fell);
    color: var(--t-verm);
  }
  .pnw-sheet__meta {
    font: 600 .72rem/1.3 var(--f-mono);
    letter-spacing: .04em;
    color: var(--t-ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .pnw-sheet__body,
  .pnw-sheet__links {
    margin: 0 0 var(--line);
    line-height: var(--line);
    background: repeating-linear-gradient(180deg, transparent 0 calc(var(--line) - 1px), color-mix(in srgb, var(--t-ultra) 18%, transparent) calc(var(--line) - 1px) var(--line));
  }
  .pnw-sheet a { color: var(--t-ultra); }
  .pnw-sheet__links span { font-weight: 600; }
  .pnw-sheet__visit {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    align-self: flex-start;
    margin-top: auto;
    color: var(--t-green) !important;
    line-height: 1.4;
  }

  /* ---- diplomas ---- */
  .pnw-diplomas { display: grid; gap: clamp(2rem, 5vw, 3rem); }
  .pnw-dipl-obj { display: flex; flex-direction: column; }
  .pnw-dipl {
    display: grid;
    place-content: center;
    justify-items: center;
    min-block-size: 14.5rem;
    padding: 2rem 1.4rem 4.2rem;
    text-align: center;
    border-radius: 3px;
    background-color: color-mix(in srgb, var(--t-paper) 85%, var(--t-paper3));
  }
  .pnw-dipl__k { margin: 0; font: 700 clamp(.58rem, 1.8vw, .76rem)/1.2 var(--f-display); letter-spacing: .28em; text-transform: uppercase; color: var(--dink); }
  .pnw-dipl h3 {
    margin: .5rem 0 .25rem;
    font: 900 clamp(1.25rem, 5vw, 2.35rem)/1.05 var(--f-display);
    color: var(--t-ink);
    text-wrap: balance;
    max-inline-size: 20ch;
  }
  .pnw-dipl h3 a { color: inherit; text-decoration: none; }
  .pnw-dipl h3 a:hover { text-decoration: underline; }
  .pnw-dipl__deg { margin: .3rem 0; font: italic 400 clamp(1.02rem, 3.6vw, 1.6rem)/1.15 var(--f-fell); color: var(--dink); }
  .pnw-dipl__cls { margin: 0; font: 700 clamp(.62rem, 2vw, .82rem)/1.2 var(--f-display); letter-spacing: .22em; text-transform: uppercase; }
  .pnw-dipl__seal {
    position: absolute !important;
    right: 5%;
    bottom: 6%;
    width: clamp(2.6rem, 5.2vw, 4.6rem);
    aspect-ratio: 1;
    border-radius: 50%;
    color: color-mix(in srgb, var(--t-gold-ink) 70%, black);
    background: conic-gradient(var(--t-gold-ink), color-mix(in srgb, var(--t-gold) 40%, white), var(--t-gold), white, var(--t-gold-ink), color-mix(in srgb, var(--t-gold) 60%, white), var(--t-gold-ink));
    box-shadow: 0 2px 4px rgb(0 0 0 / .35);
  }
  .pnw-dipl__seal svg { width: 100%; height: 100%; display: block; }
  .pnw-dipl__seal path { fill: none; stroke: currentColor; stroke-width: .5; }
  .pnw-dipl__fine {
    position: relative;
    flex: 1;
    margin: .75rem 0 0;
    padding: 1.25rem 1.2rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--t-ink) 16%, transparent);
    border-radius: 3px;
    background-color: var(--t-paper3);
    color: var(--t-ink);
    font-family: var(--f-text);
    font-size: .98rem;
    line-height: 1.55;
    box-shadow: 0 8px 16px rgb(0 0 0 / .28);
  }
  .pnw-dipl__fine p { margin: 0 0 .7rem; }
  .pnw-dipl__fine ul { margin: 0; padding: 0; list-style: none; display: grid; gap: .45rem; }
  .pnw-dipl__fine li a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    padding: .35rem .6rem;
    border: 1px solid color-mix(in srgb, var(--t-ultra) 28%, transparent);
    border-radius: 3px;
    background: color-mix(in srgb, var(--t-ultra) 5%, transparent);
    color: var(--t-ultra);
    font-size: .9rem;
    text-decoration: none;
  }
  .pnw-dipl__fine li a:hover {
    background: color-mix(in srgb, var(--t-ultra) 11%, transparent);
    border-color: var(--t-ultra);
  }
  .pnw-dipl__fine::before {
    content: '';
    position: absolute;
    top: -.55rem;
    left: 50%;
    width: 4.5rem;
    height: 1.15rem;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--t-gold) 45%, transparent);
    z-index: 6;
  }

  @media (min-width: 30rem) {
    .pnw-sheet {
      padding: var(--line) 1.35rem var(--line) 3.2rem;
      background:
        radial-gradient(circle at 1.05rem 3.5rem, color-mix(in srgb, var(--color-tender-pine) 70%, transparent) 0 .38rem, transparent .43rem),
        radial-gradient(circle at 1.05rem 50%, color-mix(in srgb, var(--color-tender-pine) 70%, transparent) 0 .38rem, transparent .43rem),
        radial-gradient(circle at 1.05rem calc(100% - 3.5rem), color-mix(in srgb, var(--color-tender-pine) 70%, transparent) 0 .38rem, transparent .43rem),
        linear-gradient(90deg, transparent 2.25rem, color-mix(in srgb, var(--t-verm) 45%, white) 2.25rem calc(2.25rem + 2px), transparent calc(2.25rem + 2px)),
        var(--fibre),
        var(--t-paper3);
    }
  }

  @media (min-width: 40rem) {
    .pnw-diplomas { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; }
    .pnw-dipl {
      min-block-size: 16.5rem;
      padding: clamp(1.6rem, 3.5vw, 2.8rem) clamp(1.4rem, 3.5vw, 3rem) clamp(4.6rem, 7.5vw, 5.6rem);
    }
  }

  @media (min-width: 48rem) {
    .pnw-cpost__card { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 2.4rem; }
    .pnw-cpost__addr { padding: 4.8rem 0 0 1.6rem; border-left: 1.5px solid color-mix(in srgb, var(--t-ink) 28%, transparent); }
    .pnw-sheets { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; }
  }

  @media (min-width: 48rem) and (max-width: 67.49rem) {
    .pnw-sheet-obj:last-child { grid-column: 1 / -1; }
    .pnw-sheet-obj:last-child .pnw-sheet {
      display: grid;
      grid-template-columns: minmax(14rem, .85fr) minmax(0, 1.35fr);
      column-gap: 1.75rem;
      align-items: start;
    }
    .pnw-sheet-obj:last-child .pnw-sheet__head { grid-column: 1 / -1; }
    .pnw-sheet-obj:last-child .pnw-polaroid {
      grid-column: 1;
      grid-row: 2 / span 8;
      margin-bottom: 0;
      align-self: start;
    }
    .pnw-sheet-obj:last-child .pnw-sheet > :not(.pnw-sheet__head, .pnw-polaroid, .pnw-uvl) {
      grid-column: 2;
    }
    .pnw-sheet-obj:last-child .pnw-sheet__visit {
      justify-self: start;
      margin-top: .25rem;
    }
  }

  @media (min-width: 54rem) {
    .pnw-dipl {
      aspect-ratio: 11 / 8.5;
      padding: clamp(1.8rem, 3.5vw, 3rem) clamp(1.6rem, 3.5vw, 3.2rem) clamp(5rem, 7.5vw, 6.2rem);
    }
  }

  @media (min-width: 67.5rem) {
    .pnw-sheets { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
