---
import { Image } from 'astro:assets';
import ButtonLink from './ButtonLink.astro';
import IconButton from './IconButton.astro';
import { legacyIcons } from '../data/legacy-icons.mjs';

interface Profile {
  name: string;
  role: string;
  tagline: string;
  credential?: string;
  portrait?: string | {
    src: string;
    srcSet?: string;
    alt: string;
  };
  heroImages: {
    sm?: string;
    md?: string;
    lg?: string;
  };
  primaryAction?: {
    label: string;
    target: string;
  };
}

interface SocialLink {
  label: string;
  href: string;
  icon?: any;
  legacyIcon?: keyof typeof legacyIcons;
}

interface Props {
  profile: Profile;
  socialLinks: SocialLink[];
  chevronIcon: any;
}

const { profile, socialLinks, chevronIcon: ChevronDown } = Astro.props;
const heroStyle = `--hero-image-sm: url('${profile.heroImages.sm}'); --hero-image-md: url('${profile.heroImages.md}'); --hero-image-lg: url('${profile.heroImages.lg}');`;
const primaryAction = profile.primaryAction ?? { label: "Let's get in touch", target: '#hire-me' };
const portrait =
  typeof profile.portrait === 'string'
    ? { src: profile.portrait, alt: profile.name }
    : profile.portrait;
---

<section class="c-hero" style={heroStyle} aria-labelledby="site-title">
  <div class="l-container c-hero__grid">
    <div class="c-hero__spacer" aria-hidden="true"></div>

    <div class="c-hero__content">
      {portrait && (
        <div class="c-hero__portrait-frame">
          <Image
            src={portrait.src}
            srcset={portrait.srcSet}
            alt={portrait.alt}
            width={200}
            height={200}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}
      <h1 id="site-title">{profile.name}</h1>
      <p class="c-hero__role">{profile.role}</p>
      {profile.credential && <p class="c-hero__credential">{profile.credential}</p>}
      <p class="c-hero__tagline">{profile.tagline}</p>

      <nav class="c-hero__social" aria-label="Social links">
        {socialLinks.map((link) => <IconButton href={link.href} label={link.label} icon={link.icon} legacyIcon={link.legacyIcon} />)}
      </nav>

      <ButtonLink href={primaryAction.target} variant="light" size="lg" class="c-hero__cta">{primaryAction.label}</ButtonLink>
    </div>

    <p class="c-hero__scroll">
      <span>Scroll to read more...</span>
      <ChevronDown aria-hidden="true" />
    </p>
  </div>
</section>
