---
import { Image } from 'astro:assets';
import type { createResumeViewModel } from '../data/resume-data.mjs';

type Resume = ReturnType<typeof createResumeViewModel>;

interface Props {
  profile: Resume['profile'];
  skills: Resume['skills'];
}

const { profile, skills } = Astro.props;
const credentialTitle = 'Anthropic Claude Certified Architect';
const credential = skills.technical.find((skill) => skill.title === credentialTitle);
const technical = skills.technical.filter((skill) => skill !== credential);

const words = ['Entry', 'Admitted', 'Cleared', 'Approved', 'Valid', 'Passed'];
const inks = ['var(--t-verm)', 'var(--t-ultra)', 'var(--t-green)', 'var(--t-gold-ink)', 'var(--t-ink)', 'var(--t-teal)'];

function visa(title: string, index: number, seed: number) {
  return {
    title,
    word: words[(index + seed) % words.length],
    ink: inks[(index * 5 + seed) % inks.length],
    mp: `${(index * 53) % 180}px ${(index * 29) % 180}px`,
    date: title === 'Ruby on Rails' ? 'Since 2007' : `Nº ${String(index + 1).padStart(2, '0')}`,
  };
}

const leadershipGroup = {
  title: 'Endorsements · Leadership',
  label: 'Leadership Qualities',
  ink: 'var(--t-green)',
  visas: skills.leadership.map((s, i) => visa(s.title, i, 3)),
};
const technicalGroup = {
  title: 'Endorsements · Technical',
  label: 'Technical Skills',
  ink: 'var(--t-ultra)',
  visas: technical.map((s, i) => visa(s.title, i, 0)),
};
const mrz = 'P<USABROCOUM<<PHILIP<<<<<<<<<<<<<<<<<<<<<<<<';
const mrz2 = 'LEADSWENG<PDX<2007<<<<<<<<<<<<<<<<<<<<<<<<18';
---

<section id="about-skills" class="pnw-section pnw-pp-section" aria-labelledby="pnw-passport-title">
  <div class="pnw-wrap">
    <header class="pnw-head">
      <div class="pnw-head__meta">
        <span class="pnw-head__no">Nº 02 · Passport</span>
        <span class="pnw-head__rule" aria-hidden="true"></span>
      </div>
      <h2 id="pnw-passport-title">Phil's Skillset</h2>
      <p class="pnw-head__lead">My passport, stamped at every border I've crossed since 2007.</p>
    </header>

    <div class="pnw-obj pnw-pp">
      <div class="pnw-paper pnw-pp__page pnw-pp__id" data-g="pp">
        <div class="pnw-pp__top"><span>Passport · Identification</span><span class="pnw-serial">P&lt;USA</span></div>
        <div class="pnw-pp__identity">
          {profile.portrait && (
            <div class="pnw-pp__portrait">
              <Image src={profile.portrait.src} srcset={profile.portrait.srcSet} alt={profile.portrait.alt} width={160} height={160} loading="lazy" />
            </div>
          )}
          <dl class="pnw-pp__fields">
            <div class="pnw-pp__f pnw-pp__f--w"><dt class="pnw-lbl">Name</dt><dd class="pnw-pp__name">{profile.name}</dd></div>
            <div class="pnw-pp__f pnw-pp__f--w"><dt class="pnw-lbl">Occupation</dt><dd class="pnw-pp__role">{profile.role}</dd></div>
            <div class="pnw-pp__f"><dt class="pnw-lbl">Residence</dt><dd>Portland, Oregon</dd></div>
            <div class="pnw-pp__f"><dt class="pnw-lbl">In software since</dt><dd>2007</dd></div>
          </dl>
        </div>

        <div class="pnw-pp__sig" aria-hidden="true">Philip Brocoum</div>

        {credential && (
          <a class="pnw-pp__visa-sticker" href={credential.href}>
            <span class="pnw-pp__foil" aria-hidden="true"></span>
            <span class="pnw-pp__vk">Verified Credential · Anthropic</span>
            <b>Anthropic Claude Certified Architect</b>
            <span class="pnw-pp__vk">Verify on Credly ↗</span>
          </a>
        )}

        <div class="pnw-pp__group pnw-pp__group--lead" style={`--group-ink:${leadershipGroup.ink}`}>
          <div class="pnw-pp__top"><span>{leadershipGroup.title}</span><span class="pnw-serial">LEAD · 08 YRS</span></div>
          <h3 class="pnw-pp__sr">{leadershipGroup.label}</h3>
          <ul class="pnw-pp__stamps pnw-pp__stamps--lead">
            {leadershipGroup.visas.map((v) => (
              <li class="pnw-visa" style={`--visa-ink:${v.ink}`}>
                <div class="pnw-visa__meta" aria-hidden="true">
                  <span class="pnw-visa__w">{v.word}</span>
                  <span class="pnw-visa__d">{v.date}</span>
                </div>
                <b>{v.title}</b>
              </li>
            ))}
          </ul>
        </div>

        <div class="pnw-pp__mrz" aria-hidden="true">{mrz}<br />{mrz2}</div>
        <div class="pnw-uvl" aria-hidden="true">
          <svg viewBox="-50 -50 100 100" style="right:-12%;bottom:-10%;width:40%"><path data-rose="32,9,20,14" /></svg>
          <span class="t" style="left:1rem;bottom:.65rem;font-size:.52rem;letter-spacing:.14em">GENUINE · PDX · BROCOUM · 2007</span>
        </div>
      </div>

      <div class="pnw-paper pnw-pp__page pnw-pp__visas" data-g="pp">
        <div class="pnw-pp__group" style={`--group-ink:${technicalGroup.ink}`}>
          <div class="pnw-pp__top"><span>{technicalGroup.title}</span><span class="pnw-serial">P&lt;PDX&lt;BROCOUM</span></div>
          <h3 class="pnw-pp__sr">{technicalGroup.label}</h3>
          <ul class="pnw-pp__stamps">
            {technicalGroup.visas.map((v) => (
              <li class="pnw-visa" style={`--visa-ink:${v.ink}`}>
                <div class="pnw-visa__meta" aria-hidden="true">
                  <span class="pnw-visa__w">{v.word}</span>
                  <span class="pnw-visa__d">{v.date}</span>
                </div>
                <b>{v.title}</b>
              </li>
            ))}
          </ul>
        </div>
        <div class="pnw-uvl" aria-hidden="true">
          <svg viewBox="-50 -50 100 100" style="right:-10%;bottom:-8%;width:40%"><path data-rose="30,8,16,12" /></svg>
          <span class="t" style="left:1rem;bottom:.65rem;font-size:.52rem;letter-spacing:.14em">VERIFIED · TECHNICAL · ENDORSEMENTS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pnw-pp-section {
    position: relative;
    z-index: 5;
  }
  .pnw-pp-section .pnw-head { position: relative; z-index: 2; }

  .pnw-pp {
    display: grid;
    max-inline-size: 72rem;
    margin-inline: auto;
    gap: 2px;
  }
  .pnw-pp::before {
    content: '';
    position: absolute;
    inset: -10px;
    z-index: -1;
    border-radius: 14px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--t-ultra) 45%, var(--t-table)), color-mix(in srgb, var(--t-ultra) 28%, var(--t-table)));
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--t-gold) 60%, transparent), inset 0 0 0 6px color-mix(in srgb, var(--t-ultra) 35%, var(--t-table)), inset 0 0 0 7px color-mix(in srgb, var(--t-gold) 40%, transparent);
  }
  .pnw-pp__page {
    display: flex;
    flex-direction: column;
    padding: 1.3rem 1.15rem 1.8rem;
    border-radius: 6px;
    background-color: color-mix(in srgb, var(--t-paper) 92%, var(--t-teal));
  }
  .pnw-pp__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: .75rem;
    font: 700 .66rem/1.2 var(--f-display);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--group-ink, var(--t-ultra));
    border-bottom: 1px solid currentColor;
    padding-bottom: .4rem;
    margin-bottom: 1rem;
  }
  .pnw-pp__top .pnw-serial { font-size: .6rem; letter-spacing: .06em; flex-shrink: 0; }

  .pnw-pp__identity {
    display: grid;
    grid-template-columns: minmax(5rem, 32%) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  .pnw-pp__portrait {
    position: relative;
    aspect-ratio: .82;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 3px var(--t-paper3), 0 0 0 4.5px var(--t-ultra), 0 0 0 8px var(--t-paper3), 0 0 0 9px color-mix(in srgb, var(--t-ultra) 60%, transparent);
    margin: 9px;
  }
  .pnw-pp__portrait img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: grayscale(1) sepia(.35) contrast(1.05);
  }
  .pnw-pp__fields { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem .9rem; margin: 0; }
  .pnw-pp__f { min-inline-size: 0; }
  .pnw-pp__f--w { grid-column: 1 / -1; }
  .pnw-pp__fields dt { color: var(--t-green); opacity: .95; font-size: .65rem; margin-bottom: .1rem; }
  .pnw-pp__fields dd { margin: 0; font-size: .95rem; line-height: 1.25; font-weight: 500; }
  .pnw-pp__name { font: 900 clamp(1.35rem, 5vw, 2.2rem)/1 var(--f-display) !important; overflow-wrap: anywhere; }
  .pnw-pp__role { font: italic 400 clamp(1.05rem, 3.6vw, 1.3rem)/1.15 var(--f-fell) !important; color: var(--t-verm); }
  .pnw-pp__sig {
    align-self: flex-start;
    margin: .75rem 0 1rem;
    display: inline-block;
    font: 600 1.95rem/1 var(--f-hand);
    color: var(--t-ultra);
    border-bottom: 1px solid color-mix(in srgb, var(--t-ink) 45%, transparent);
    padding-right: 1rem;
  }

  .pnw-pp__visa-sticker {
    position: relative;
    display: block;
    inline-size: 100%;
    margin: 0 0 1.4rem;
    padding: .95rem 1.05rem .9rem 3.7rem;
    border: 1px solid color-mix(in srgb, var(--t-ultra) 28%, transparent);
    border-radius: 6px;
    text-decoration: none;
    color: var(--t-ink);
    background: linear-gradient(100deg, color-mix(in srgb, var(--t-ultra) 18%, white), color-mix(in srgb, var(--t-gold) 22%, white) 36%, color-mix(in srgb, var(--t-verm) 16%, white) 68%, color-mix(in srgb, var(--t-green) 16%, white) 92%);
    box-shadow: 0 2px 6px rgb(0 0 0 / .16);
    transition: transform .35s var(--spring), box-shadow .25s ease;
  }
  .pnw-pp__visa-sticker:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgb(0 0 0 / .2);
  }
  .pnw-pp__visa-sticker b {
    display: block;
    margin: .22rem 0 .25rem;
    font: 900 clamp(.98rem, 3.6vw, 1.24rem)/1.12 var(--f-display);
    color: var(--t-ink);
  }
  .pnw-pp__vk {
    display: block;
    font: 700 .62rem/1.2 var(--f-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--t-ultra);
  }
  .pnw-pp__foil {
    position: absolute;
    left: .9rem;
    top: 50%;
    width: 2.1rem;
    height: 2.1rem;
    margin-top: -1.05rem;
    border-radius: 50%;
    background: conic-gradient(var(--t-gold-ink), color-mix(in srgb, var(--t-gold) 40%, white), var(--t-gold), white, var(--t-gold-ink), color-mix(in srgb, var(--t-gold) 60%, white), var(--t-gold-ink));
    box-shadow: 0 0 0 2px rgb(255 248 220 / .7), inset 0 0 0 3px rgb(255 248 220 / .35);
  }

  .pnw-pp__group--lead { margin-top: .25rem; }
  .pnw-pp__mrz {
    margin-top: auto;
    padding-top: 1.2rem;
    font: 400 clamp(.46rem, 2vw, .72rem)/1.4 var(--f-mono);
    letter-spacing: .08em;
    color: var(--t-ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
  }

  .pnw-pp__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .pnw-pp__stamps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .55rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .pnw-visa {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .2rem;
    min-inline-size: 0;
    padding: .55rem .7rem;
    border: 1.5px solid color-mix(in srgb, var(--visa-ink) 45%, transparent);
    border-left: 3.5px solid var(--visa-ink);
    border-radius: 3px;
    background: color-mix(in srgb, var(--visa-ink) 4%, var(--t-paper3));
    color: var(--visa-ink);
  }
  .pnw-visa__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: .4rem;
    font: 600 .58rem/1.1 var(--f-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
    opacity: .88;
  }
  .pnw-visa b {
    display: block;
    font: 600 .92rem/1.22 var(--f-text);
    color: var(--t-ink);
    overflow-wrap: break-word;
  }

  @media (min-width: 22.5rem) {
    .pnw-pp__stamps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pnw-pp__stamps--lead .pnw-visa:last-child { grid-column: 1 / -1; }
  }
  @media (min-width: 54rem) {
    .pnw-pp { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
    .pnw-pp__page { padding: 1.6rem 1.8rem 2rem; }
    .pnw-pp__id { border-radius: 8px 2px 2px 8px; box-shadow: inset -34px 0 40px -34px rgb(60 40 10 / .5); }
    .pnw-pp__visas { border-radius: 2px 8px 8px 2px; box-shadow: inset 34px 0 40px -34px rgb(60 40 10 / .5); }
    .pnw-pp__stamps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  }
  @media (min-width: 70rem) {
    .pnw-pp__visas .pnw-pp__stamps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 34rem) {
    .pnw-pp::before { inset: -7px; }
    .pnw-pp__top { font-size: .58rem; letter-spacing: .14em; margin-bottom: .75rem; }
    .pnw-pp__fields dd { font-size: .9rem; }
    .pnw-pp__page { padding-inline: 1rem; }
  }
  @media (max-width: 24rem) {
    .pnw-pp__identity { grid-template-columns: 1fr; }
    .pnw-pp__portrait { max-inline-size: 6.8rem; }
    .pnw-pp__fields { grid-template-columns: 1fr; }
  }
</style>
