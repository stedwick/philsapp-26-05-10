---
import { Image } from 'astro:assets';
import type { createResumeViewModel } from '../data/resume-data.mjs';

type Resume = ReturnType<typeof createResumeViewModel>;

interface Props {
  profile: Resume['profile'];
  skills: Resume['skills'];
}

const { profile, skills } = Astro.props;
const credentialTitle = 'Anthropic Claude Certified Architect';
const credential = skills.technical.find((skill) => skill.title === credentialTitle);
const technical = skills.technical.filter((skill) => skill !== credential);

// Rubber-stamp variety, fixed per position so the page renders the same
// every time (same rules as the storyboard's passport).
const words = ['Entry', 'Admitted', 'Cleared', 'Approved', 'Valid', 'Passed'];
const inks = ['var(--t-verm)', 'var(--t-ultra)', 'var(--t-green)', 'var(--t-gold-ink)', 'var(--t-ink)', 'var(--t-teal)'];
const shapes = ['rect', 'round', 'double', 'oval', 'solid', 'rect', 'round'];
const dates = ['Portland · OR', 'PDX', 'P. Brocoum'];
function visa(title: string, index: number, seed: number) {
  return {
    title,
    word: words[(index + seed) % words.length],
    ink: inks[(index * 5 + seed) % inks.length],
    shape: shapes[(index * 3 + seed) % shapes.length],
    rot: ((index * 37 + seed * 11) % 13) - 6,
    mp: `${(index * 53) % 180}px ${(index * 29) % 180}px`,
    date: title === 'Ruby on Rails' ? 'Since 2007' : (index + seed) % 4 === 3 ? `Nº ${String(index + 1).padStart(2, '0')}` : dates[(index + seed) % 4 % 3],
  };
}
const groups = [
  { title: 'Visas · Technical', label: 'Technical Skills', ink: 'var(--t-ultra)', visas: technical.map((s, i) => visa(s.title, i, 0)) },
  { title: 'Visas · Leadership', label: 'Leadership Qualities', ink: 'var(--t-green)', visas: skills.leadership.map((s, i) => visa(s.title, i, 3)) },
];
const mrz = 'P<USABROCOUM<<PHILIP<<<<<<<<<<<<<<<<<<<<<<<<';
const mrz2 = 'LEADSWENG<PDX<2007<<<<<<<<<<<<<<<<<<<<<<<<18';
---

<section id="about-skills" class="pnw-section pnw-pp-section" data-surface="leather" aria-labelledby="pnw-passport-title">
  <div class="pnw-wrap">
    <div class="pnw-head">
      <span class="pnw-head__no">Nº 02 · Passport</span>
      <h2 id="pnw-passport-title">Phil's Skillset</h2>
      <p>My passport, stamped at every border I've crossed since 2007.</p>
      <p class="pnw-pp-stamp" aria-hidden="true"><span>Cleared</span><span>for entry</span></p>
    </div>

    <div class="pnw-obj pnw-pp" style="--r:-1deg">
      <div class="pnw-paper pnw-pp__page pnw-pp__id" data-g="pp">
        <div class="pnw-pp__top"><span>Passport · Identification</span><span class="pnw-serial">P&lt;USA</span></div>
        <div class="pnw-pp__identity">
          {profile.portrait && (
            <div class="pnw-pp__portrait">
              <Image src={profile.portrait.src} srcset={profile.portrait.srcSet} alt={profile.portrait.alt} width={160} height={160} loading="lazy" />
            </div>
          )}
          <dl class="pnw-pp__fields">
            <div class="pnw-pp__f pnw-pp__f--w"><dt class="pnw-lbl">Name</dt><dd class="pnw-pp__name">{profile.name}</dd></div>
            <div class="pnw-pp__f pnw-pp__f--w"><dt class="pnw-lbl">Occupation</dt><dd class="pnw-pp__role">{profile.role}</dd></div>
            <div class="pnw-pp__f"><dt class="pnw-lbl">Residence</dt><dd>Portland, Oregon</dd></div>
            <div class="pnw-pp__f"><dt class="pnw-lbl">In software since</dt><dd>2007</dd></div>
          </dl>
        </div>
        <div class="pnw-pp__sig" aria-hidden="true">Philip Brocoum</div>
        {credential && (
          <a class="pnw-pp__visa-sticker" href={credential.href}>
            <span class="pnw-pp__foil" aria-hidden="true"></span>
            <span class="pnw-pp__vk">Visa · Anthropic · Certified</span>
            <b>Claude Certified Architect</b>
            <span class="pnw-pp__vk">Verify on Credly ↗</span>
          </a>
        )}
        <div class="pnw-pp__mrz" aria-hidden="true">{mrz}<br />{mrz2}</div>
        <div class="pnw-uvl" aria-hidden="true">
          <svg viewBox="-50 -50 100 100" style="right:-18%;bottom:-14%;width:42%"><path data-rose="32,9,20,14" /></svg>
          <span class="t" style="left:1.2rem;bottom:.7rem;font-size:.55rem;letter-spacing:.2em">GENUINE · P&lt;PDX&lt;BROCOUM&lt;&lt;PHILIP&lt;&lt;2007</span>
        </div>
      </div>

      <div class="pnw-paper pnw-pp__page pnw-pp__visas" data-g="pp">
        {groups.map((group) => (
          <div class="pnw-pp__group" style={`--group-ink:${group.ink}`}>
            <div class="pnw-pp__top"><span>{group.title}</span><span class="pnw-serial">P&lt;PDX&lt;BROCOUM</span></div>
            <h3 class="pnw-pp__sr">{group.label}</h3>
            <ul class="pnw-pp__stamps">
              {group.visas.map((v) => (
                <li class:list={['pnw-inked pnw-visa', `pnw-visa--${v.shape}`]} style={`color:${v.ink};--rot:${v.rot}deg;--mp:${v.mp}`}>
                  <span class="pnw-visa__w" aria-hidden="true">{v.word}</span>
                  <b>{v.title}</b>
                  <span class="pnw-visa__d" aria-hidden="true">{v.date}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div class="pnw-uvl" aria-hidden="true">
          <svg viewBox="-50 -50 100 100" style="right:-10%;bottom:-8%;width:40%"><path data-rose="30,8,16,12" /></svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pnw-pp-section .pnw-head { position: relative; z-index: 2; }
  .pnw-pp-stamp {
    position: absolute;
    right: -.5rem;
    bottom: -4.2rem;
    margin: 0 !important;
    font: 900 clamp(1.5rem, 6vw, 3.2rem)/.92 var(--f-display) !important;
    display: inline-flex !important;
    flex-direction: column;
    align-items: center;
    color: color-mix(in srgb, var(--t-verm) 85%, white) !important;
    text-transform: uppercase;
    letter-spacing: .04em !important;
    padding: .7rem 1.4rem .55rem;
    border: 7px double currentColor;
    border-radius: 14px;
    transform: rotate(-5deg);
    text-shadow: none !important;
    -webkit-mask: var(--stampmask) 0 0 / 240px;
    mask: var(--stampmask) 0 0 / 240px;
    mix-blend-mode: screen;
  }
  .pnw-pp-stamp span:last-child { font-size: .48em; letter-spacing: .3em; }

  .pnw-pp {
    display: grid;
    max-inline-size: 70rem;
    margin-inline: auto;
    gap: 2px;
  }
  .pnw-pp::before {
    content: '';
    position: absolute;
    inset: -12px;
    z-index: -1;
    border-radius: 16px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--t-ultra) 45%, var(--t-table)), color-mix(in srgb, var(--t-ultra) 28%, var(--t-table)));
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--t-gold) 60%, transparent), inset 0 0 0 7px color-mix(in srgb, var(--t-ultra) 35%, var(--t-table)), inset 0 0 0 8px color-mix(in srgb, var(--t-gold) 40%, transparent);
  }
  .pnw-pp__page {
    padding: 1.3rem 1.2rem 1.6rem;
    border-radius: 6px;
    background-color: color-mix(in srgb, var(--t-paper) 92%, var(--t-teal));
  }
  .pnw-pp__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font: 700 .68rem/1.2 var(--f-display);
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--group-ink, var(--t-ultra));
    border-bottom: 1px solid currentColor;
    padding-bottom: .4rem;
    margin-bottom: 1rem;
  }
  .pnw-pp__top .pnw-serial { font-size: .62rem; letter-spacing: .06em; }

  .pnw-pp__identity {
    display: grid;
    grid-template-columns: minmax(5.5rem, 34%) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  .pnw-pp__portrait {
    position: relative;
    aspect-ratio: .8;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 3px var(--t-paper3), 0 0 0 4.5px var(--t-ultra), 0 0 0 8px var(--t-paper3), 0 0 0 9px color-mix(in srgb, var(--t-ultra) 60%, transparent);
    margin: 9px;
  }
  .pnw-pp__portrait img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: grayscale(1) sepia(.35) contrast(1.05);
  }
  .pnw-pp__fields { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem 1rem; margin: 0; }
  .pnw-pp__f { min-inline-size: 0; }
  .pnw-pp__f--w { grid-column: 1 / -1; }
  .pnw-pp__fields dt { color: var(--t-green); opacity: .9; font-size: .68rem; margin-bottom: .1rem; }
  .pnw-pp__fields dd { margin: 0; font-size: .98rem; line-height: 1.2; font-weight: 500; }
  .pnw-pp__name { font: 900 clamp(1.5rem, 6vw, 2.4rem)/.95 var(--f-display) !important; overflow-wrap: anywhere; }
  .pnw-pp__role { font: italic 400 clamp(1.1rem, 4vw, 1.4rem)/1.1 var(--f-fell) !important; color: var(--t-verm); }
  .pnw-pp__sig {
    margin: .6rem 0 1rem;
    display: inline-block;
    font: 600 2.1rem/1 var(--f-hand);
    color: var(--t-ultra);
    border-bottom: 1px solid color-mix(in srgb, var(--t-ink) 50%, transparent);
    padding-right: 1rem;
    transform: rotate(-3deg);
    transform-origin: left bottom;
  }

  .pnw-pp__visa-sticker {
    position: relative;
    display: block;
    max-inline-size: 26rem;
    margin: 0 auto 1.1rem;
    padding: .9rem 1rem .8rem 3.4rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--t-ink);
    background: linear-gradient(100deg, color-mix(in srgb, var(--t-ultra) 22%, white), color-mix(in srgb, var(--t-gold) 26%, white) 32%, color-mix(in srgb, var(--t-verm) 22%, white) 58%, color-mix(in srgb, var(--t-green) 20%, white) 84%);
    box-shadow: 0 1px 3px rgb(0 0 0 / .3);
    transform: rotate(1.2deg);
    transition: transform .5s var(--spring);
  }
  .pnw-pp__visa-sticker:hover { transform: rotate(0) translateY(-2px); }
  .pnw-pp__visa-sticker b { display: block; margin: .25rem 0; font: 900 clamp(1.05rem, 4.4vw, 1.4rem)/1.05 var(--f-display); }
  .pnw-pp__vk { display: block; font: 700 .6rem/1.2 var(--f-display); letter-spacing: .18em; text-transform: uppercase; color: var(--t-ultra); }
  .pnw-pp__foil {
    position: absolute;
    left: .8rem;
    top: 50%;
    width: 2rem;
    height: 2rem;
    margin-top: -1rem;
    border-radius: 50%;
    background: conic-gradient(var(--t-gold-ink), color-mix(in srgb, var(--t-gold) 40%, white), var(--t-gold), white, var(--t-gold-ink), color-mix(in srgb, var(--t-gold) 60%, white), var(--t-gold-ink));
    box-shadow: 0 0 0 2px rgb(255 248 220 / .6);
  }
  .pnw-pp__mrz {
    font: 400 clamp(.5rem, 2.3vw, .78rem)/1.4 var(--f-mono);
    letter-spacing: .1em;
    color: var(--t-ink-soft);
    white-space: nowrap;
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, black 82%, transparent);
    mask: linear-gradient(90deg, black 82%, transparent);
  }

  .pnw-pp__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .pnw-pp__group + .pnw-pp__group { margin-top: 1.6rem; }
  .pnw-pp__stamps {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem .8rem;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .pnw-visa {
    max-inline-size: 11rem;
    padding: .35rem .7rem .3rem;
    border: 2.5px solid currentColor;
    text-align: center;
    font-family: var(--f-display);
    line-height: 1.05;
    transform: rotate(var(--rot));
    opacity: .93;
  }
  .pnw-visa b { display: block; margin: .15rem 0; font: 700 .92rem/1.1 var(--f-text); letter-spacing: 0; }
  .pnw-visa__w, .pnw-visa__d { display: block; font-size: .7rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .pnw-visa--double { border-style: double; border-width: 5px; }
  .pnw-visa--round {
    display: flex;
    flex-direction: column;
    justify-content: center;
    inline-size: 6.6rem;
    block-size: 6.6rem;
    border-radius: 50%;
    padding: .5rem;
  }
  .pnw-visa--round b { font-size: .82rem; }
  .pnw-visa--oval { border-radius: 50%; padding: .7rem 1.2rem; }
  .pnw-visa--solid { background: currentColor; }
  .pnw-visa--solid > * { color: var(--t-paper3); }

  @media (min-width: 52rem) {
    .pnw-pp { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
    .pnw-pp__page { padding: 1.6rem 1.8rem 2rem; min-block-size: 36rem; }
    .pnw-pp__id { border-radius: 8px 2px 2px 8px; box-shadow: inset -34px 0 40px -34px rgb(60 40 10 / .5); }
    .pnw-pp__visas { border-radius: 2px 8px 8px 2px; box-shadow: inset 34px 0 40px -34px rgb(60 40 10 / .5); }
  }
  @media (max-width: 34rem) {
    .pnw-pp::before { inset: -8px; }
    .pnw-pp-stamp { right: 0; bottom: -3.4rem; font-size: 1.35rem !important; border-width: 5px; padding: .45rem .8rem .35rem; }
    .pnw-pp__top { padding-right: 0; font-size: .58rem; letter-spacing: .14em; }
    .pnw-pp__fields dd { font-size: .9rem; }
    .pnw-pp__id .pnw-pp__top { margin-top: 2.2rem; }
    .pnw-pp__id { padding-bottom: 2.2rem; }
    .pnw-pp__page { padding-inline: 1rem; }
    .pnw-pp__group + .pnw-pp__group { margin-top: 1.1rem; }
    .pnw-pp__top { margin-bottom: .7rem; }
    .pnw-pp__stamps { gap: .35rem .4rem; }
    .pnw-visa__w, .pnw-visa__d { display: none; }
    .pnw-visa { padding: .18rem .5rem; max-inline-size: none; transform: rotate(calc(var(--rot) * .15)); border-width: 2px; }
    .pnw-visa b { font-size: .8rem; margin: 0; }
    .pnw-visa { max-inline-size: 100%; }
    .pnw-visa--double { border-width: 4px; }
    .pnw-visa--round { inline-size: auto; block-size: auto; border-radius: 999px; padding: .35rem .8rem; }
    .pnw-visa--oval { padding: .35rem .9rem; }
  }
  @media (max-width: 23rem) {
    .pnw-pp__identity { grid-template-columns: 1fr; }
    .pnw-pp__portrait { max-inline-size: 7rem; }
    .pnw-visa { max-inline-size: 9.5rem; }
  }
</style>
