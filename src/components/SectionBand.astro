---
import Container from './Container.astro';

interface Props {
  id?: string;
  title?: string;
  mobileTitleLines?: string[];
  tone?: 'light' | 'white' | 'dark' | 'info';
  headingLevel?: 2 | 3 | 4;
  containerSize?: 'normal' | 'narrow';
  showRule?: boolean;
  class?: string;
}

const {
  id,
  title,
  mobileTitleLines,
  tone = 'light',
  headingLevel = 2,
  containerSize = 'normal',
  showRule: shouldShowRule,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}`;
const showRule = shouldShowRule ?? headingLevel === 2;
---

<section id={id} class:list={['c-section-band', `c-section-band--${tone}`, className]}>
  <Container size={containerSize}>
    {title && (
      <header class="c-section-band__header">
        <Heading class="c-section-band__title">
          {mobileTitleLines ? (
            <>
              <span class="c-section-band__title-full">{title}</span>
              <span class="c-section-band__title-mobile">
                {mobileTitleLines.map((line, index) => (
                  <>{index > 0 && <br />}{line}</>
                ))}
              </span>
            </>
          ) : (
            title
          )}
        </Heading>
        {showRule && <hr class="c-section-band__rule" />}
      </header>
    )}
    <slot />
  </Container>
</section>
