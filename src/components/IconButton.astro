---
import { legacyIcons } from '../data/legacy-icons.mjs';

interface Props {
  href: string;
  label: string;
  icon?: any;
  legacyIcon?: keyof typeof legacyIcons;
  variant?: 'outline-light' | 'outline-dark';
}

const { href, label, icon: Icon, legacyIcon, variant = 'outline-light' } = Astro.props;

const LegacyIcon = legacyIcon ? legacyIcons[legacyIcon] : undefined;
---

<a class:list={['c-icon-button', `c-icon-button--${variant}`]} href={href} aria-label={label} title={label}>
  {LegacyIcon ? (
    <svg class="c-legacy-icon" aria-hidden="true" viewBox={LegacyIcon.viewBox} fill="currentColor">
      <Fragment set:html={LegacyIcon.markup} />
    </svg>
  ) : (
    Icon && <Icon aria-hidden="true" />
  )}
</a>
