---
import { Image } from 'astro:assets';
import ButtonLink from './ButtonLink.astro';

interface Props {
  title: string;
  siteLabel: string;
  href: string;
  logo?: string | {
    src: string;
    srcSet?: string;
    alt: string;
  };
  image?: string | {
    src: string;
    srcSet?: string;
    alt: string;
  };
  imageAlt?: string;
  body: string;
  action: string;
  links?: { label: string; href: string }[];
  footer: string[];
}

const { title, siteLabel, href, logo, image, imageAlt = title, body, action, links, footer } = Astro.props;
const logoSource = typeof logo === 'string' ? { src: logo, alt: '' } : logo;
const imageSource = typeof image === 'string' ? { src: image, alt: imageAlt } : image;
---

<article class="c-work-card">
  <header class="c-work-card__header">
    {logoSource && <Image src={logoSource.src} srcset={logoSource.srcSet} alt="" width={32} height={32} loading="lazy" />}
    <a href={href}>{siteLabel}</a>
  </header>
  <div class="c-work-card__body">
    {imageSource && (
      <a class="c-work-card__image" href={href}>
        <Image src={imageSource.src} srcset={imageSource.srcSet} alt={imageSource.alt} width={600} height={341} loading="lazy" />
      </a>
    )}
    <h3>{title}</h3>
    <p>{body}</p>
    {links && links.length > 0 && (
      <p>Portfolio: {links.map((link, i) => (<>{i > 0 && ' · '}<a href={link.href}>{link.label}</a></>))}</p>
    )}
    <ButtonLink href={href}>{action}</ButtonLink>
  </div>
  <footer class="c-work-card__footer">
    {footer.map((line) => <span>{line}</span>)}
  </footer>
</article>
