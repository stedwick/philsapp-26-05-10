---
import { Image } from 'astro:assets';
import ButtonLink from './ButtonLink.astro';
import { legacyIcons } from '../data/legacy-icons.mjs';

interface Action {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'light';
}

interface Props {
  title: string;
  href?: string;
  body: string;
  icon?: any;
  legacyIcon?: keyof typeof legacyIcons;
  image?: {
    src: string;
    srcSet?: string;
    alt: string;
  };
  addendum?: string;
  actions?: Action[];
  compact?: boolean;
}

const { title, href, body, icon: Icon, legacyIcon, image, addendum, actions = [], compact = false } = Astro.props;
const LegacyIcon = legacyIcon ? legacyIcons[legacyIcon] : undefined;
---

<article class:list={['c-media-item', { 'c-media-item--compact': compact }]}>
  {image && href && (
    <a class="c-media-item__icon" href={href ?? '#'} aria-label={title}>
      <Image src={image.src} srcset={image.srcSet} alt="" width={64} height={64} loading="lazy" />
    </a>
  )}
  {image && !href && (
    <span class="c-media-item__icon" aria-hidden="true">
      <Image src={image.src} srcset={image.srcSet} alt="" width={64} height={64} loading="lazy" />
    </span>
  )}
  {!image && LegacyIcon && href && (
    <a class="c-media-item__icon" href={href ?? '#'} aria-label={title}>
      <svg class="c-legacy-icon" aria-hidden="true" viewBox={LegacyIcon.viewBox} fill="currentColor">
        <Fragment set:html={LegacyIcon.markup} />
      </svg>
    </a>
  )}
  {!image && LegacyIcon && !href && (
    <span class="c-media-item__icon" aria-hidden="true">
      <svg class="c-legacy-icon" aria-hidden="true" viewBox={LegacyIcon.viewBox} fill="currentColor">
        <Fragment set:html={LegacyIcon.markup} />
      </svg>
    </span>
  )}
  {!image && !LegacyIcon && Icon && href && (
    <a class="c-media-item__icon" href={href ?? '#'} aria-label={title}>
      <Icon aria-hidden="true" />
    </a>
  )}
  {!image && !LegacyIcon && Icon && !href && (
    <span class="c-media-item__icon" aria-hidden="true">
      <Icon aria-hidden="true" />
    </span>
  )}
  <div class="c-media-item__body">
    <h3 class="c-media-item__title">
      {href ? <a href={href}>{title}</a> : title}
    </h3>
    {addendum && <p class="c-media-item__addendum">{addendum}</p>}
    <p>{body}</p>
    {actions.length > 0 && (
      <div class="c-media-item__actions">
        {actions.map((action) => (
          <ButtonLink href={action.href} variant={action.variant ?? 'secondary'} size="sm">
            {action.label}
          </ButtonLink>
        ))}
      </div>
    )}
  </div>
</article>
