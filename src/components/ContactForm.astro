---
import { icons } from '../data/site';

interface Props {
  action?: string;
}

const { CircleUserRound, Mail, Send } = icons;
const { action = 'https://formspree.io/f/mjgnzjzd' } = Astro.props;
---

<form class="c-contact-form" action={action} method="post">
  <label class="u-visually-hidden" for="name">Your name</label>
  <div class="c-input-group">
    <input id="name" name="name" type="text" placeholder="Your name" autocomplete="name" />
    <CircleUserRound aria-hidden="true" />
  </div>

  <label class="u-visually-hidden" for="email">Your email address</label>
  <div class="c-input-group">
    <input id="email" name="email" type="email" placeholder="Your email address" autocomplete="email" />
    <Mail aria-hidden="true" />
  </div>

  <label class="u-visually-hidden" for="message">Your message to me</label>
  <textarea id="message" name="message" placeholder="Your message to me" rows="6"></textarea>

  <button class="c-button c-button--primary c-button--md" type="submit">
    <Send aria-hidden="true" class="c-button__icon" />
    <span>Send Email</span>
  </button>
</form>
