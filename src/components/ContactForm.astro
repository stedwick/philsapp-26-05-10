---
import { icons } from '../data/site';

interface Props {
  action?: string;
}

const { CircleUserRound, Mail, Send } = icons;
const { action = 'https://formspree.io/f/mjgnzjzd' } = Astro.props;
---

<form class="c-contact-form" action={action} method="post">
  <div class="c-form-field">
    <label for="name">Name</label>
    <div class="c-input-control">
      <CircleUserRound aria-hidden="true" />
      <input id="name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
    </div>
  </div>

  <div class="c-form-field">
    <label for="email">Email</label>
    <div class="c-input-control">
      <Mail aria-hidden="true" />
      <input id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
    </div>
  </div>

  <div class="c-form-field">
    <label for="message">Message</label>
    <textarea id="message" name="message" placeholder="What would you like to talk about?" rows="6" required></textarea>
  </div>

  <div
    class="cf-turnstile"
    data-sitekey="0x4AAAAAAEpTsDJ50yyL_qeZ"
    data-action="contact"
    data-appearance="interaction-only"
    data-size="flexible"
    data-theme="auto"
  ></div>
  <p data-turnstile-status role="status" hidden></p>
  <noscript>Enable JavaScript to complete the security check and send a message.</noscript>

  <button class="c-button c-button--primary c-button--md" type="submit">
    <span>Send message</span>
    <Send aria-hidden="true" class="c-button__icon" />
  </button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.c-contact-form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-turnstile-status]')!;

    form.addEventListener('submit', (event) => {
      const token = new FormData(form).get('cf-turnstile-response');
      status.hidden = typeof token === 'string' && token.length > 0;

      if (!status.hidden) {
        event.preventDefault();
        status.textContent = 'Please wait for the security check and complete any challenge shown, then try again. If it does not load, allow challenges.cloudflare.com in your browser and reload the page.';
      }
    });
  });

  const script = document.createElement('script');
  script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  script.async = true;
  script.addEventListener('load', () => {
    const { turnstile } = window as Window & {
      turnstile: {
        render(container: HTMLElement, options: Record<string, string>): string;
        remove(widgetId: string): void;
      };
    };

    document.querySelectorAll<HTMLElement>('.c-contact-form .cf-turnstile').forEach((container) => {
      let widgetId: string | undefined;
      let currentSize: string;

      new ResizeObserver(([entry]) => {
        const size = entry.contentRect.width < 300 ? 'compact' : 'flexible';
        // Preserve the token on resizes that do not cross Turnstile's 300px minimum.
        if (size === currentSize) return;
        currentSize = size;
        if (widgetId) turnstile.remove(widgetId);
        container.dataset.size = size;
        widgetId = turnstile.render(container, {
          sitekey: container.dataset.sitekey!,
          action: container.dataset.action!,
          appearance: container.dataset.appearance!,
          theme: container.dataset.theme!,
          size,
        });
      }).observe(container);
    });
  });
  document.head.append(script);
</script>
