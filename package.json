{
  "name": "philsapp-26-05-10",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:portless": "portless run --name philsapp -- bun run dev:portless:server",
    "dev:portless:server": "astro dev --host \"$HOST\" --port \"$PORT\"",
    "build": "astro build",
    "preview": "bun run build && wrangler dev",
    "astro": "astro",
    "import:legacy": "bun scripts/import-legacy-site.mjs",
    "import:blog": "bun scripts/import-blog-site.mjs",
    "verify:content": "bun scripts/verify-content.mjs",
    "verify:blog": "bun scripts/verify-blog-content.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:legacy-live": "bun scripts/test-legacy-live.mjs",
    "test:blog-live": "bun scripts/test-blog-live.mjs",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@lucide/astro": "^1.27.0",
    "astro": "^7.1.5"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "wrangler": "^4.118.0"
  }
}
